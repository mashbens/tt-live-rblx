-- Dideklarasikan di sini, diisi jauh di bawah. Di Lua sebuah local hanya
-- berlaku dari baris definisinya ke bawah, dan resetStage memanggilnya.
local pindahSlot

local function isGiantSlot(slot)
	return slot >= GIANT_BASE
end

-- Posisi slot. Nomor >= GIANT_BASE memakai barisan belakang, bukan
-- barisan kerumunan -- dua perhitungan yang benar-benar terpisah.
-- Kolom ke-i barisan belakang, diisi dari TENGAH lalu melebar
-- bergantian: 0, +1, -1, +2, -2, ...
--
-- Kalau dihitung seperti barisan kerumunan (kolom 0 = ujung kiri),
-- raksasa pertama berdiri di pinggir layar sendirian sementara tengah
-- panggung kosong -- persis yang terjadi waktu BACK_ROW_SIZE dinaikkan
-- jadi 10.
local function backCol(i)
	local step = math.floor((i + 1) / 2)
	if i % 2 == 1 then return step end
	return -step
end

local function getPosition(slot)
	if isGiantSlot(slot) then
		local i   = slot - GIANT_BASE
		local row = math.floor(i / BACK_ROW_SIZE)
		local col = i % BACK_ROW_SIZE
		local x = backCol(col) * BACK_SPACING_X
		-- Baris kedua dan seterusnya makin ke belakang (Z makin positif).
		local z = BACK_Z + row * BACK_SPACING_Z
		return CFrame.new(x, BASE_Y, z)
	end

	local i   = slot - 1
	local row = math.floor(i / ROW_SIZE)
	local col = i % ROW_SIZE
	local x = (col - (ROW_SIZE - 1) / 2) * SPACING_X
	local z = -row * SPACING_Z
	return CFrame.new(x, BASE_Y, z)
end

-- Jarak kamera ikut skala avatarnya. Tanpa ini, kamera tier 1 (12 studs
-- di belakang) berdiri DI DALAM raksasa skala 8x saat dia mendarat.
-- Jarak dari HumanoidRootPart ke telapak kaki, dibaca dari rig-nya
-- sendiri sesudah ScaleTo.
--
-- Dipakai HipHeight, bukan GetBoundingBox. Roblox mendefinisikan
-- HipHeight persis sebagai jarak dari SISI BAWAH HumanoidRootPart ke
-- tanah tempat karakter berdiri, dan ScaleTo ikut menyesuaikannya. Jadi
-- jarak pivot ke telapak kaki = HipHeight + setengah tinggi HRP.
--
-- Kenapa bukan kotak pembungkus: kotak itu ikut membungkus AKSESORI.
-- Rambut panjang, sayap, ekor, atau apa pun yang menjulur ke bawah
-- menggeser sisi bawah kotak, dan avatarnya jadi terangkat sebanyak
-- itu -- persis "tier 2 mengambang" sementara avatar polos tier 1
-- kelihatan pas. Kotak pembungkus tetap dipakai, tapi cuma sebagai
-- cadangan kalau rig-nya tidak punya Humanoid/HRP.
local function tinggiPivot(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hum and hrp then
		local ok, hasil = pcall(function()
			return hum.HipHeight + hrp.Size.Y / 2
		end)
		if ok and hasil and hasil > 0 then
			return hasil
		end
	end

	local ok, hasil = pcall(function()
		local kotak, ukuran = model:GetBoundingBox()
		return model:GetPivot().Position.Y
		- (kotak.Position.Y - ukuran.Y / 2)
	end)
	if ok and hasil and hasil > 0 then
		return hasil
	end
	return nil
end

-- Permukaan tempat avatar slot ini berdiri.
--
-- Untuk kerumunan itu lantai panggung; untuk tier 3 itu permukaan
-- podiumnya. Satu-satunya tempat perbedaan tinggi tier 3 hidup di kode
-- ini -- selebihnya dia diperlakukan persis seperti avatar biasa.
local function lantaiSlot(slot)
	if PODIUM_ENABLED and isGiantSlot(slot) then
		return FLOOR_Y + PODIUM_HEIGHT
	end
	return FLOOR_Y
end

-- Tinggi pivot untuk sebuah slot. Kalau `model` diberikan, diukur ulang
-- dan disimpan; kalau tidak, dipakai hasil pengukuran terakhir.
local function tinggiSlot(slot, model, scale)
	if model then
		local diukur = tinggiPivot(model)
		if diukur then
			heights[slot] = lantaiSlot(slot) + diukur
		end
	end
	return heights[slot]
		or (lantaiSlot(slot) + BASE_Y
			+ ((scale or 1) - 1) * SCALE_Y_LIFT)
end

-- ======================= PODIUM TIER 3 =======================

-- Silinder Roblox berdiri di sumbu X-nya sendiri. Semua silinder di
-- bawah diputar 90 derajat supaya tegak, dan Size.X-nya jadi TINGGI.
local function silinderTegak(tinggi, diameter)
	local p = Instance.new("Part")
	p.Shape       = Enum.PartType.Cylinder
	p.Size        = Vector3.new(tinggi, diameter, diameter)
	p.Anchored    = true
	p.CanCollide  = false
	p.CanQuery    = false
	p.CanTouch    = false
	return p
end

local function taruhSilinder(p, x, yTengah, z)
	p.CFrame = CFrame.new(x, yTengah, z) * CFrame.Angles(0, 0, math.rad(90))
end

-- Bangun podium di slot ini dan naikkan dari dalam tanah.
--
-- Podium dibangun LEBIH DULU dari avatarnya, lalu naik selama avatarnya
-- masih dibuat. Waktu si tamu turun, podiumnya sudah menunggu -- bukan
-- muncul menyusul di bawah kakinya.
local function buatPodium(slot, username, koin)
	if not PODIUM_ENABLED then return nil end

	-- Podium lama di nomor ini (kalau ada) dibuang tanpa animasi:
	-- tempatnya sedang diambil alih, bukan ditinggalkan.
	local lama = podiums[slot]
	if lama then
		lama:Destroy()
		podiums[slot] = nil
	end

	local dasar = getPosition(slot)
	local x, z  = dasar.Position.X, dasar.Position.Z
	local warna = PODIUM_COLOR

	local podium = Instance.new("Model")
	podium.Name = "Podium"

	-- Badan
	local alas = silinderTegak(PODIUM_HEIGHT, PODIUM_RADIUS * 2)
	alas.Name     = "Alas"
	alas.Material = Enum.Material.Metal
	alas.Color    = warna
	taruhSilinder(alas, x, FLOOR_Y + PODIUM_HEIGHT / 2, z)
	alas.Parent   = podium
	podium.PrimaryPart = alas

	-- Tepi menyala di permukaan atas. Cincin tipis ini yang bikin
	-- podiumnya terbaca sebagai benda bercahaya, bukan tabung cat kuning.
	local tepi = silinderTegak(0.7, (PODIUM_RADIUS + 0.7) * 2)
	tepi.Name         = "Tepi"
	tepi.Material     = Enum.Material.Neon
	tepi.Color        = PODIUM_GLOW
	taruhSilinder(tepi, x, FLOOR_Y + PODIUM_HEIGHT - 0.35, z)
	tepi.Parent       = podium

	-- Garis bercahaya di kaki podium, supaya bagian bawahnya tidak
	-- tenggelam jadi bayangan hitam saat panggung remang.
	local kaki = silinderTegak(0.5, (PODIUM_RADIUS + 0.4) * 2)
	kaki.Name     = "Kaki"
	kaki.Material = Enum.Material.Neon
	kaki.Color    = PODIUM_GLOW
	taruhSilinder(kaki, x, FLOOR_Y + 0.25, z)
	kaki.Parent   = podium

	-- Papan nama di badan podium, menghadap kamera (sisi Z negatif).
	local papan = Instance.new("Part")
	papan.Name         = "Papan"
	papan.Size         = Vector3.new(PODIUM_RADIUS * 1.7, PODIUM_PLATE_H, 0.2)
	papan.Anchored     = true
	papan.CanCollide   = false
	papan.CanQuery     = false
	papan.CanTouch     = false
	papan.Material     = Enum.Material.SmoothPlastic
	papan.Color        = Color3.fromRGB(30, 24, 10)
	papan.CFrame       = CFrame.new(
		x, FLOOR_Y + PODIUM_HEIGHT * 0.55, z - PODIUM_RADIUS - 0.12
	)
	papan.Parent       = podium

	local sg = Instance.new("SurfaceGui")
	sg.Face           = Enum.NormalId.Front   -- Front menghadap Z negatif
	sg.CanvasSize     = Vector2.new(400, 100)
	sg.LightInfluence = 0
	sg.Parent         = papan

	-- Angka KOIN ditulis di papan, bukan cuma dipakai memperpanjang
	-- sorotan.
	--
	-- Efek yang lebih ramai dinikmati si pengirim; ANGKA yang terbaca itu
	-- yang bikin penonton lain ikut mengirim. Ini bagian termurah dari
	-- fitur ini, dan bagian yang paling bekerja.
	--
	-- Dulu yang ditulis jumlah gift ("x5"). Diganti koin karena jumlah
	-- gift tidak bisa dibandingkan antar-gift: "x5" rose (5 koin) terbaca
	-- lebih besar daripada "x1" rosa (10 koin), padahal yang kedua bayar
	-- dua kali lipat. Koin satu-satunya angka yang adil dibandingkan.
	local teksPapan = username
	if koin and koin > 0 then
		teksPapan = username .. "  " .. koin .. " koin"
	end

	local label = Instance.new("TextLabel")
	label.Size                   = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text                   = teksPapan
	label.TextColor3             = PODIUM_GLOW
	label.Font                   = Enum.Font.GothamBold
	label.TextScaled             = true
	label.Parent                 = sg

	-- Sengaja redup dan pendek jangkauannya.
	--
	-- Lampu ini tugasnya menandai podium, BUKAN menerangi tamunya.
	-- Ditaruh di permukaan podium, jarak ke badan si tamu cuma beberapa
	-- studs -- jadi terang sedikit saja sudah cukup untuk membakar warna
	-- bajunya jadi putih rata. Naikkan kalau podiumnya kurang terlihat,
	-- tapi cek dulu bajunya masih kebaca.
	local lampu = Instance.new("PointLight")
	lampu.Color      = PODIUM_GLOW
	lampu.Brightness = 0.7
	lampu.Range      = 14
	lampu.Parent     = tepi

	podium.Parent = workspace

	-- Naik dari dalam tanah.
	--
	-- Digerakkan per-frame, bukan Tween: yang perlu bergerak adalah
	-- SELURUH model, dan Tween cuma bisa menganimasikan properti satu
	-- objek. Memindahkan model lewat PivotTo tiap frame jauh lebih
	-- sederhana daripada membuat satu tween untuk tiap part.
	local puncak = podium:GetPivot()
	local bawah  = puncak - Vector3.new(0, PODIUM_HEIGHT + 2, 0)
	podium:PivotTo(bawah)

	task.spawn(function()
		local mulai = os.clock()
		while podium.Parent do
			local t = (os.clock() - mulai) / PODIUM_RISE
			if t >= 1 then break end
			-- Melambat di akhir saja: naiknya terasa bertenaga di awal
			-- lalu mendarat lembut, bukan mengambang sepanjang jalan.
			local e = 1 - (1 - t) * (1 - t) * (1 - t)
			podium:PivotTo(bawah:Lerp(puncak, e))
			RunService.Heartbeat:Wait()
		end
		if podium.Parent then
			podium:PivotTo(puncak)
		end
	end)

	-- Kolom cahaya dipasang SESUDAH podiumnya berdiri, dan memudar
	-- masuk. Kalau ikut naik dari bawah tanah, yang terlihat cuma
	-- balok raksasa menyembul -- bukan cahaya.
	task.spawn(function()
		task.wait(PODIUM_RISE * 0.7)
		if not podium.Parent then return end

		local kolom = silinderTegak(PODIUM_BEAM_HEIGHT, PODIUM_RADIUS * 1.25)
		kolom.Name         = "Kolom"
		kolom.Material     = Enum.Material.Neon
		kolom.Color        = PODIUM_GLOW
		kolom.Transparency = 1
		taruhSilinder(kolom, x,
			FLOOR_Y + PODIUM_HEIGHT + PODIUM_BEAM_HEIGHT / 2, z)
		kolom.Parent       = podium

		TweenService:Create(
			kolom,
			TweenInfo.new(0.8, Enum.EasingStyle.Quad),
			{ Transparency = PODIUM_BEAM_ALPHA }
		):Play()
	end)

	podiums[slot] = podium
	return podium
end

-- Tenggelamkan podium kembali ke tanah lalu hapus.
--
-- `langsung = true` -> hapus SEKETIKA tanpa animasi. Dipakai saat pemiliknya
-- sendiri mengirim gift lagi: podium lama dan baru berdiri di titik yang
-- persis sama, jadi kalau yang lama tenggelam sambil yang baru naik, yang
-- terlihat cuma dua tabung saling menembus.
local function hapusPodium(slot, langsung)
	local podium = podiums[slot]
	if not podium then return end
	podiums[slot] = nil

	if langsung or not podium.Parent then
		podium:Destroy()
		return
	end

	task.spawn(function()
		local atas  = podium:GetPivot()
		local bawah = atas - Vector3.new(0, PODIUM_HEIGHT + 2, 0)
		local mulai = os.clock()

		while podium.Parent do
			local t = (os.clock() - mulai) / PODIUM_SINK
			if t >= 1 then break end
			podium:PivotTo(atas:Lerp(bawah, t * t))
			RunService.Heartbeat:Wait()
		end

		podium:Destroy()
	end)
end

-- Gerakkan kamera ke pendatang baru.
--
-- Yang dikerjakan di sini cuma KEPUTUSANNYA: boleh jalan atau tidak,
-- berapa lama, dan gaya nomor berapa. Gerakannya sendiri -- termasuk
-- tabel titik-awal tiap gaya (`awalKamera`) -- ada di LocalScript.
--
-- `waktu`  : lama gerakan. Diisi spawnAvatar supaya BERAKHIR tepat saat
--            avatarnya mendarat.
-- `paksa`  : jalan walau sorotan sedang aktif. Cuma dipakai runSpotlight
--            waktu memulangkan kamera ke kerumunan.
local function focusCamera(targetPos, scale, waktu, paksa)
	-- Sorotan menyetir kamera per-frame. Tanpa penjaga ini, tiap orang
	-- yang mendarat di tengah sorotan bikin kameranya bergetar di antara
	-- dua tujuan. Client punya penjaga kembarnya; yang di sini menghemat
	-- paket yang memang tidak akan dipakai.
	if spotlightBusy and not paksa then return end

	local lama = math.max(waktu or CAMERA_TIME, 0.05)

	-- Gerakan sebelumnya masih jalan?
	--
	-- Gaya 2-5 mulai dari titik yang jauh, jadi memakainya sekarang berarti
	-- kameranya LONCAT ke sana. Antar-kedatangan itu tidak apa-apa -- itu
	-- namanya potongan, dan tiap kedatangan memang satu adegan sendiri.
	-- Tapi di TENGAH gerakan yang belum selesai, loncatan yang sama
	-- terbaca sebagai kamera rusak.
	--
	-- Jadi aturannya: memotong antar adegan boleh, memotong di tengah
	-- adegan tidak. Yang datang selagi kamera masih bergerak dapat gaya 1
	-- (geser halus dari posisi sekarang), yang tidak pernah meloncat.
	local masihBergerak = os.clock() < camSelesai
	camSelesai = os.clock() + lama

	local gaya = 1
	if CAM_CINEMATIC and not masihBergerak then
		-- Diacak, tapi tidak boleh sama dengan yang barusan: gaya yang
		-- terulang dua kali beruntun langsung terbaca sebagai pengulangan,
		-- dan itu justru kebalikan dari yang kita mau.
		repeat
			gaya = math.random(1, 5)
		until gaya ~= camGayaLalu
		camGayaLalu = gaya
	end

	-- Arah ayunan orbit (gaya 5) diundi DI SINI, bukan di client.
	-- Alasannya sama dengan gayanya: dua penonton yang mengundi sendiri-
	-- sendiri akan melihat kamera mengayun ke arah yang berlawanan.
	local arahOrbit = (math.random(1, 2) == 1) and -1 or 1

	KameraEvent:FireAllClients("focus", {
		pos   = targetPos,
		scale = scale,
		lama  = lama,
		paksa = paksa and true or false,
		gaya  = gaya,
		arah  = arahOrbit,
	})
end

-- Sentakan kamera saat ada yang mendarat.
--
-- Gelung getarnya di LocalScript; yang di sini cuma sakelar dan
-- pemberitahuannya.
local function guncangKamera(kekuatan, lama)
	if not SHAKE_ENABLED then return end

	-- Sorotan menyetir kamera per-frame juga. Dua penulis untuk satu
	-- CFrame berarti dua-duanya patah -- dan yang mengalah harus yang
	-- gratis, bukan yang sedang menyorot orang yang bayar.
	if spotlightBusy then return end

	KameraEvent:FireAllClients("shake", {
		kekuatan = kekuatan,
		lama     = lama,
	})
end

-- Ekor cahaya yang mengikuti avatar selama jatuh.
--
-- Trail menggambar jejak antara DUA attachment, jadi lebarnya = jarak
-- kedua attachment itu (METEOR_TRAIL_WIDTH), bukan properti tersendiri.
-- Jalan walau avatarnya masih Anchored: yang dibaca Trail cuma posisi
-- attachment dari waktu ke waktu, bukan fisika.
local function pasangEkorMeteor(model, warna)
	if not (METEOR_ENABLED and METEOR_TRAIL) then return nil end

	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end

	local atas = Instance.new("Attachment")
	atas.Name     = "EkorAtas"
	atas.Position = Vector3.new(0, METEOR_TRAIL_WIDTH / 2, 0)
	atas.Parent   = hrp

	local bawah = Instance.new("Attachment")
	bawah.Name     = "EkorBawah"
	bawah.Position = Vector3.new(0, -METEOR_TRAIL_WIDTH / 2, 0)
	bawah.Parent   = hrp

	local ekor = Instance.new("Trail")
	ekor.Name        = "EkorMeteor"
	ekor.Attachment0 = atas
	ekor.Attachment1 = bawah
	ekor.Color       = ColorSequence.new(warna)
	ekor.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	-- Menyempit ke belakang, jadi bentuknya kerucut seperti ekor komet --
	-- bukan pita selebar badan yang terbaca seperti kain.
	ekor.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	})
	ekor.Lifetime       = METEOR_TRAIL_LIFE
	ekor.LightEmission  = 1
	ekor.LightInfluence = 0
	ekor.FaceCamera     = true
	ekor.Parent         = hrp

	return ekor
end

-- Matikan ekornya, lalu biarkan sisa jejaknya memudar sendiri.
--
-- Dihapus seketika, ekornya putus mendadak di udara -- yang justru lebih
-- kelihatan daripada dibiarkan habis.
local function lepasEkorMeteor(ekor)
	if not ekor then return end
	ekor.Enabled = false
	Debris:AddItem(ekor, METEOR_TRAIL_LIFE + 0.2)
end

-- Warna dihitung dari username, bukan diacak.
--
-- Kenapa: kalau diacak, orang yang sama dapat warna berbeda tiap kali
-- muncul. Dengan hash sederhana, warnanya selalu konsisten per orang.
local function colorFromUsername(username)
	local hash = 0
	for i = 1, #username do
		hash = (hash * 31 + string.byte(username, i)) % 360
	end
	return Color3.fromHSV(hash / 360, 0.65, 1)
end

-- Papan nama custom di atas kepala.
--
-- CATATAN: fungsi ini HARUS didefinisikan sebelum spawnAvatar.
-- Di Lua, local function hanya dikenali dari baris definisinya ke bawah.
local function createNameplate(model, username, nameStyle, scale, koin)
	local head = model:FindFirstChild("Head")
	if not head then return end

	-- Papan lama dibuang dulu. Dipanggil ulang saat avatar naik tier.
	local lama = head:FindFirstChild("Nameplate")
	if lama then lama:Destroy() end

	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	local color = FX_COLOR_NAME
		and colorFromUsername(username)
		or Color3.fromRGB(255, 255, 255)

	-- Warna per-username sengaja DIGANTI emas untuk tier 2 ke atas.
	-- Yang bayar harus kelihatan beda dari kejauhan, dan warna acak
	-- per orang justru bikin tier tidak terbaca.
	local teks  = username
	local lebar = PLATE_WIDTH

	if nameStyle == "gold" then
		color = Color3.fromRGB(255, 205, 60)
	elseif nameStyle == "crown" then
		color = Color3.fromRGB(255, 225, 90)
		teks  = "👑 " .. username
		lebar = PLATE_WIDTH + 50
	end

	-- Angka koin ikut ditulis untuk yang bayar.
	--
	-- Ini menutup lubang lama: dulu angka kiriman cuma tampil di papan
	-- PODIUM, jadi tier 2 sama sekali tidak berubah di layar antara
	-- kiriman kecil dan kiriman besar -- rose x1 dan rose x5 identik, dan
	-- yang kirim lima merasa empat gift-nya hilang. Sekarang tiap tambahan
	-- koin kelihatan sebagai angka yang naik di atas kepalanya.
	--
	-- Tier 3 dilewati: papan podiumnya sudah menuliskan angka yang sama,
	-- dan dua angka identik pada satu avatar terbaca seperti bug.
	if koin and koin > 0 and nameStyle == "gold" then
		teks  = teks .. "  " .. koin .. " koin"
		lebar = PLATE_WIDTH + 60
	end

	local gui = Instance.new("BillboardGui")
	gui.Name        = "Nameplate"
	gui.Size        = UDim2.new(0, lebar, 0, PLATE_HEIGHT)
	-- Offset ikut skala: pada avatar raksasa, jarak 2.2 studs membuat papan
	-- namanya tenggelam di dalam kepala.
	gui.StudsOffset = Vector3.new(0, PLATE_OFFSET * (scale or 1), 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = PLATE_DIST
	gui.Parent      = head

	-- Frame-nya tetap ada TAPI tembus pandang: dia cuma wadah supaya
	-- UIPadding punya tempat menempel. Yang dihapus itu kotak hitam,
	-- sudut membulat, dan garis tepinya.
	local bg = Instance.new("Frame")
	bg.Size                   = UDim2.new(1, 0, 1, 0)
	bg.BackgroundTransparency = 1
	bg.BorderSizePixel        = 0
	bg.Parent                 = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft   = UDim.new(0, 8)
	padding.PaddingRight  = UDim.new(0, 8)
	padding.PaddingTop    = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.Parent        = bg

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name                   = "Username"
	nameLabel.Size                   = UDim2.new(1, 0, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text                   = teks
	nameLabel.TextColor3             = color
	nameLabel.Font                   = Enum.Font.GothamBold
	nameLabel.TextScaled             = true

	-- Bayangan pada hurufnya, bukan kotak di belakangnya.
	if PLATE_TEXT_SHADOW then
		nameLabel.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
		nameLabel.TextStrokeTransparency = 0.35
	else
		nameLabel.TextStrokeTransparency = 1
	end

	nameLabel.Parent = bg

	-- Papan nama muncul dengan efek membesar, tidak nongol mendadak
	gui.Size = UDim2.new(0, 0, 0, 0)
	TweenService:Create(
		gui,
		TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = UDim2.new(0, lebar, 0, PLATE_HEIGHT) }
	):Play()

	return gui
end

-- Baris keberapa sebuah nomor kerumunan. Baris 0 = paling belakang
-- (Z = 0), angkanya naik ke arah kamera.
local function barisSlot(slot)
	return math.floor((slot - 1) / ROW_SIZE)
end

-- Lepaskan papan nama semua avatar yang barisnya di BELAKANG baris ini.
--
-- Dipanggil tiap ada avatar baru berdiri. Selama baris masih terisi,
-- tidak ada yang kehilangan nama; begitu orang pertama mengisi baris
-- berikutnya, seluruh nama baris sebelumnya lepas sekaligus.
--
-- Yang dilepas cuma papan namanya. Avatarnya tetap di tempat, tetap
-- menari, dan tetap dihitung sampai reset panggung biasa.
local function hapusNamaBarisBelakang(slotBaru)
	if not PLATE_FRONT_ROW_ONLY then return end
	-- Podium tidak punya "baris di depan" -- nomornya bukan bagian dari
	-- barisan kerumunan sama sekali.
	if isGiantSlot(slotBaru) then return end

	local barisDepan = barisSlot(slotBaru)
	if barisDepan <= 0 then return end

	-- Hanya 1..slotCount: nomor podium (>= GIANT_BASE) tidak pernah masuk
	-- rentang ini, jadi papan namanya aman tanpa perlu dicek satu-satu.
	for slot = 1, slotCount do
		if barisSlot(slot) < barisDepan then
			local model = avatars[slot]
			local head  = model and model.Parent and model:FindFirstChild("Head")
			local papan = head and head:FindFirstChild("Nameplate")
			if papan then
				-- Diganti namanya DULU. Kalau tidak, createNameplate yang
				-- jalan untuk avatar ini beberapa saat lagi (naik tier)
				-- masih menemukan papan yang sedang menyusut dan mengira
				-- itu papan yang aktif.
				papan.Name = "NameplateLepas"

				if PLATE_FADE_OUT > 0 then
					TweenService:Create(
						papan,
						TweenInfo.new(PLATE_FADE_OUT, Enum.EasingStyle.Quad),
						{ Size = UDim2.new(0, 0, 0, 0) }
					):Play()
					Debris:AddItem(papan, PLATE_FADE_OUT + 0.1)
				else
					papan:Destroy()
				end
			end
		end
	end
end

-- Ledakan partikel + kilat cahaya.
--
-- Semua dibuat pada part tak terlihat yang dihapus otomatis oleh Debris,
-- jadi tidak ada sampah yang menumpuk di workspace.
local function playBurstFX(position, color, count)
	local anchor = Instance.new("Part")
	anchor.Name         = "SpawnFX"
	anchor.Size         = Vector3.new(1, 1, 1)
	anchor.Position     = position
	anchor.Anchored     = true
	anchor.CanCollide   = false
	anchor.Transparency = 1
	anchor.Parent       = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color        = ColorSequence.new(color)
	emitter.Size         = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.2),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime     = NumberRange.new(0.4, 0.9)
	emitter.Speed        = NumberRange.new(12, 22)
	emitter.SpreadAngle  = Vector2.new(180, 180)
	emitter.Rate         = 0
	emitter.Drag         = 4
	emitter.Parent       = anchor
	emitter:Emit(count or 45)

	local light = Instance.new("PointLight")
	light.Color      = color
	light.Brightness = 6
	light.Range      = 22
	light.Parent     = anchor

	TweenService:Create(
		light,
		TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Brightness = 0 }
	):Play()

	Debris:AddItem(anchor, 2)
end

local function playLandingFX(position, color)
	if not FX_PARTICLES then return end
	playBurstFX(position, color, 45)
end

-- Bunyikan satu suara.
--
-- Sound diparent ke workspace, BUKAN ke part avatarnya: sound pada part
-- itu spasial, jadi volumenya ikut jarak kamera -- dan kamera kita
-- bergerak-gerak, apalagi saat sorotan tier 3 yang mengorbit. Di
-- workspace dia terdengar rata, yang justru kita mau untuk siaran.
local function putarSuara(nama, id, volume, pitch)
	if not FX_SOUND or not id or id == "" then return end

	local s = Instance.new("Sound")
	s.Name          = nama
	s.SoundId       = id
	s.Volume        = volume or 1
	s.PlaybackSpeed = pitch or 1
	s.Parent        = workspace
	s:Play()

	-- Dibersihkan lewat Debris, bukan Ended:Connect: kalau asset-nya gagal
	-- dimuat, Ended tidak pernah menyala dan Sound-nya menumpuk selamanya.
	Debris:AddItem(s, 8)

	-- Dikembalikan supaya pemanggil bisa memotongnya lebih awal.
	-- Yang butuh cuma playFallSound; sisanya mengabaikannya.
	return s
end

-- Hentakan saat mendarat.
local function playLandSound(tier)
	if (tier or 1) < LAND_SOUND_MIN_TIER then return end

	putarSuara(
		"LandSound",
		LAND_SOUND_ID,
		(tier >= 3) and LAND_VOLUME_TIER3 or LAND_VOLUME,
		(tier >= 3) and LAND_PITCH_TIER3 or LAND_PITCH
	)
end

-- Desing meteor jatuh. Semua tier, dibunyikan saat tween jatuhnya mulai.
--
-- `lama` = lama jatuhnya, dipakai untuk menghentikannya tepat saat
-- mendarat. Diisi dari getEntrance, jadi meteor yang jatuh cepat dan
-- kedatangan lama yang jatuh pelan sama-sama pas.
local function playFallSound(lama)
	local suara = putarSuara("FallSound", FALL_SOUND_ID, FALL_VOLUME, 1)
	if not suara then return end

	-- Disetel SESUDAH :Play() (putarSuara sudah memanggilnya). TimePosition
	-- pada Sound yang belum jalan sering dikembalikan ke 0 begitu diputar.
	if FALL_SOUND_START > 0 then
		suara.TimePosition = FALL_SOUND_START
	end

	task.delay(math.max((lama or DROP_TIME) - FALL_FADE, 0), function()
		-- Avatarnya bisa keburu dihapus (reset panggung) di tengah
		-- jatuh; Sound-nya di workspace, jadi dia sendiri masih ada.
		if suara.Parent then
			TweenService:Create(suara,
				TweenInfo.new(FALL_FADE), { Volume = 0 }):Play()
		end
	end)
end

-- Sorakan "wow" -- hanya tier 3, dan hanya SESUDAH hentakan mendarat.
--
-- Ini reaksi terhadap kedatangannya, jadi urutannya penting: dibunyikan
-- bersamaan dengan hentakan, dua-duanya jadi tidak terdengar.
local function playWowSound(tier)
	if (tier or 1) < 3 then return end

	task.spawn(function()
		task.wait(WOW_DELAY)
		putarSuara("WowSound", WOW_SOUND_ID, WOW_VOLUME, 1)
	end)
end

-- Cincin gelombang yang melebar di lantai lalu memudar.
--
-- `lantai` = permukaan tempat cincinnya digambar. Untuk kerumunan itu
-- lantai panggung; untuk tier 3 itu permukaan podiumnya, kalau tidak
-- cincinnya muncul sembilan studs di bawah kaki si tamu dan tidak
-- terbaca sebagai hentakan langkahnya.
local function playShockwave(position, color, lantai)
	if not FX_SHOCKWAVE then return end

	local ring = Instance.new("Part")
	ring.Name         = "Shockwave"
	ring.Shape        = Enum.PartType.Cylinder
	ring.Size         = Vector3.new(0.3, 1, 1)
	-- Cylinder di Roblox berdiri di sumbu X, jadi diputar 90 derajat
	-- supaya rebah di lantai.
	ring.CFrame       = CFrame.new(position.X, (lantai or FLOOR_Y) + 0.3, position.Z)
		* CFrame.Angles(0, 0, math.rad(90))
	ring.Anchored     = true
	ring.CanCollide   = false
	ring.Material     = Enum.Material.Neon
	ring.Color        = color
	ring.Transparency = 0.3
	ring.Parent       = workspace

	TweenService:Create(
		ring,
		TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size         = Vector3.new(0.3, 16, 16),
			Transparency = 1,
		}
	):Play()

	Debris:AddItem(ring, 1)
end

-- ======================= EFEK TIER =======================
--
-- Nama efek datang dari server sebagai daftar string ("sparkle",
-- "confetti", "fireworks"). Nama yang tidak dikenali diabaikan diam-diam,
-- jadi server boleh menambah efek baru tanpa script ini ikut rusak.

local function punyaEfek(daftar, nama)
	if not daftar then return false end
	for _, v in ipairs(daftar) do
		if v == nama then return true end
	end
	return false
end

-- Aura yang MENETAP selama avatarnya masih berdiri. Ini pembeda tier 2
-- yang paling kebaca dari jauh, karena tidak hilang setelah sedetik.
local function pasangSparkle(model, warna)
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if hrp:FindFirstChild("TierSparkle") then return end   -- jangan dobel

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name         = "TierSparkle"
	emitter.Color        = ColorSequence.new(warna)
	emitter.Size         = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime    = NumberRange.new(0.8, 1.6)
	emitter.Rate        = 14
	emitter.Speed       = NumberRange.new(1, 3)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Acceleration = Vector3.new(0, 3, 0)
	emitter.Parent      = hrp

	-- Sengaja redup. Ini penanda, bukan penerangan -- dan kalau beberapa
	-- avatar tier 2 berdiri berdekatan, terangnya saling menumpuk.
	local glow = Instance.new("PointLight")
	glow.Name       = "TierGlow"
	glow.Color      = warna
	glow.Brightness = 0.8
	glow.Range      = 9
	glow.Parent     = hrp
end

-- Kolom cahaya yang MENETAP di atas avatar tier 2.
--
-- Diparent ke model avatarnya, bukan ke workspace: begitu avatarnya
-- dihapus saat reset panggung, kolomnya ikut hilang sendiri. Kalau
-- diparent ke workspace, panggung lama-lama penuh pilar cahaya tanpa
-- pemilik.
local function pasangKolom(model, lantai)
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if model:FindFirstChild("TierKolom") then return end   -- jangan dobel

	local kolom = silinderTegak(BEAM2_HEIGHT, BEAM2_RADIUS * 2)
	kolom.Name         = "TierKolom"
	kolom.Material     = Enum.Material.Neon
	kolom.Color        = BEAM2_COLOR
	kolom.Transparency = 1
	taruhSilinder(kolom,
		hrp.Position.X, lantai + BEAM2_HEIGHT / 2, hrp.Position.Z)
	kolom.Parent       = model

	TweenService:Create(
		kolom,
		TweenInfo.new(0.8, Enum.EasingStyle.Quad),
		{ Transparency = BEAM2_ALPHA }
	):Play()
end

local function playConfetti(position)
	local warna = {
		Color3.fromRGB(255, 90, 90),  Color3.fromRGB(90, 200, 255),
		Color3.fromRGB(255, 220, 80), Color3.fromRGB(140, 255, 140),
	}
	for _, c in ipairs(warna) do
		playBurstFX(position + Vector3.new(0, 4, 0), c, 30)
	end
end

-- Tiga letusan bertunda di atas kepala. Sengaja tidak sekaligus:
-- letusan beruntun terbaca sebagai "perayaan", sekali letus cuma
-- terbaca sebagai "efek spawn biasa".
local function playFireworks(position, warna, koin)
	-- Tiga letusan untuk kiriman terkecil, bertambah satu tiap 20 koin,
	-- berhenti di delapan. Batas atasnya bukan soal selera: tiap letusan
	-- 60 partikel, dan puluhan letusan beruntun bikin frame drop justru
	-- di detik yang paling ingin kamu tunjukkan.
	local letusan = math.clamp(3 + math.floor((koin or 0) / 20), 3, 8)

	task.spawn(function()
		for i = 1, letusan do
			local offset = Vector3.new(
				math.random(-6, 6), 8 + i * 2, math.random(-6, 6)
			)
			playBurstFX(position + offset, warna, 60)

			-- Nadanya diacak sedikit tiap letusan. Tiga letusan dengan
			-- rekaman yang sama persis terdengar seperti satu suara
			-- diulang-ulang; digeser sedikit, terdengar seperti tiga
			-- roket yang berbeda.
			putarSuara("FireworkSound", FIREWORK_SOUND_ID,
				FIREWORK_VOLUME, 0.92 + math.random() * 0.16)

			task.wait(0.35)
		end
	end)
end

local function mainkanEfek(model, effects, position, warna, lantai, koin)
	if not TIER_ENABLED or not effects then return end

	if punyaEfek(effects, "sparkle") then
		pasangSparkle(model, warna)
	end
	if punyaEfek(effects, "beam") then
		pasangKolom(model, lantai or FLOOR_Y)
	end
	if punyaEfek(effects, "confetti") then
		playConfetti(position)
	end
	if punyaEfek(effects, "fireworks") then
		playFireworks(position, warna, koin)
	end
end

-- Kamera sorotan: mengitari si raksasa sambil masuk mendekat, selama
-- `durasi` detik. Fungsi ini MENUNGGU sampai gerakannya selesai.
--
-- Gerakan melingkarnya ada di LocalScript. Yang tinggal di sini cuma
-- satu hitungan yang memang butuh tahu bentuk panggung: seberapa ke
-- pinggir orang ini berdiri.
--
-- Tunggunya pakai task.wait(durasi), bukan menunggu balasan client.
-- Panjangnya sudah pasti dan sama persis dengan gelung di sana, dan
-- runSpotlight memakai jeda ini untuk mengurutkan fade lampunya --
-- menunggu balasan dari client berarti mengikat panggung pada satu
-- penonton yang bisa saja keluar di tengah sorotan.
local function sorotKamera(target, durasi, diPodium)
	-- Seberapa ke pinggir orang ini berdiri, dinyatakan -1 (ujung kiri)
	-- sampai +1 (ujung kanan). Diukur dari lebar barisan yang dia tempati,
	-- bukan angka tetap -- barisan podium jauh lebih lebar dari kerumunan.
	local setengahLebar = diPodium
		and ((BACK_ROW_SIZE - 1) / 2 * BACK_SPACING_X)
		or  ((ROW_SIZE - 1) / 2 * SPACING_X)

	local sisi = 0
	if setengahLebar > 0 then
		sisi = math.clamp(target.X / setengahLebar, -1, 1)
	end

	KameraEvent:FireAllClients("spotlight", {
		pos      = target,
		durasi   = durasi,
		diPodium = diPodium and true or false,
		sisi     = sisi,
	})

	task.wait(durasi)
end

-- Titik yang dipandang kamera saat kembali ke kerumunan: avatar biasa
-- yang paling terakhir datang, atau tengah panggung kalau belum ada.
local function titikKerumunan()
	for slot = slotCount, 1, -1 do
		local model = avatars[slot]
		if model and model.Parent then
			return getPosition(slot).Position
		end
	end
	return Vector3.new(0, BASE_Y, 0)
end

-- Sorotan tier 3.
--
-- Yang bergerak HANYA kamera dan lampu. Raksasanya sudah berdiri di
-- tempatnya sejak mendarat, dan kerumunan tidak disentuh sama sekali.
--
-- CATATAN: server sudah menjaga jarak antar sorotan (SPOTLIGHT_GAP_S),
-- jadi penjaga `spotlightBusy` di sini cuma jaring pengaman kedua.
local function runSpotlight(model, durasiMs, diPodium)
	if not TIER_ENABLED or spotlightBusy then return end

	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	spotlightBusy = true

	task.spawn(function()
		-- Dibidik agak di BAWAH dada si tamu, supaya podiumnya ikut
		-- masuk frame. Kalau dibidik tepat ke badannya, yang terlihat
		-- cuma orang melayang -- podium dan kolom cahayanya, yaitu
		-- seluruh alasan tier 3 ini ada, jatuh di bawah layar.
		--
		-- Cuma berlaku buat yang DI ATAS podium. Tier 2 berdiri di lantai
		-- bersama kerumunan: menurunkan bidikannya 4 studs di situ bikin
		-- kamera membidik lantai, dan kepalanya kepotong di atas layar.
		local pusat = hrp.Position
		if diPodium and PODIUM_ENABLED then
			pusat = pusat - Vector3.new(0, PODIUM_HEIGHT * 0.45, 0)
		end

		local cc = nil
		if SPOTLIGHT_DIM_SCREEN then
			cc = Lighting:FindFirstChild("TierSpotlight")
			if not cc then
				cc = Instance.new("ColorCorrectionEffect")
				cc.Name   = "TierSpotlight"
				cc.Parent = Lighting
			end
			cc.Brightness = 0
			cc.TintColor  = Color3.fromRGB(255, 255, 255)
		end

		local sorot = Instance.new("PointLight")
		sorot.Name       = "SpotlightStar"
		sorot.Color      = Color3.fromRGB(255, 240, 190)
		sorot.Brightness = 0
		sorot.Range      = SPOTLIGHT_LIGHT_RANGE
		sorot.Parent     = hrp

		playShockwave(hrp.Position, Color3.fromRGB(255, 215, 90),
			(diPodium and PODIUM_ENABLED) and (FLOOR_Y + PODIUM_HEIGHT) or FLOOR_Y)

		local masuk = TweenInfo.new(SPOTLIGHT_FADE, Enum.EasingStyle.Quad)
		if cc then
			TweenService:Create(cc, masuk, {
				Brightness = SPOTLIGHT_DIM,
				TintColor  = SPOTLIGHT_TINT,
			}):Play()
		end
		TweenService:Create(sorot, masuk, { Brightness = SPOTLIGHT_LIGHT }):Play()

		sorotKamera(pusat, math.max(0.5, (durasiMs or 7000) / 1000), diPodium)

		local keluar = TweenInfo.new(SPOTLIGHT_FADE, Enum.EasingStyle.Quad)
		if cc then
			TweenService:Create(cc, keluar, {
				Brightness = 0,
				TintColor  = Color3.fromRGB(255, 255, 255),
			}):Play()
		end
		TweenService:Create(sorot, keluar, { Brightness = 0 }):Play()

		-- Kamera pulang ke kerumunan. Yang di podium tidak ke mana-mana --
		-- dia memang sudah berdiri di tempatnya sejak mendarat.
		--
		-- `paksa` = true: spotlightBusy masih menyala sampai beberapa
		-- baris lagi, dan tanpa ini focusCamera menolak jalan -- kameranya
		-- akan tertinggal menghadap podium sampai ada pendatang baru.
		focusCamera(titikKerumunan(), nil, nil, true)

		-- Ditunggu pakai task.wait, BUKAN pudar.Completed:Wait().
		--
		-- Sejak tier 2 ikut disorot, yang disorot bisa saja berdiri di
		-- barisan kerumunan yang dikosongkan di tengah sorotan. Kalau
		-- avatarnya keburu dihapus, tween pada lampu yang ikut terhapus
		-- itu dibatalkan -- dan menunggu Completed yang tidak pernah
		-- menyala berarti spotlightBusy tidak pernah dilepas: sorotan
		-- BERIKUTNYA, siapa pun yang bayar, tidak akan pernah jalan lagi
		-- sampai Play dihentikan.
		task.wait(SPOTLIGHT_FADE)
		sorot:Destroy()
		spotlightBusy = false
	end)
end

-- Pilih posisi awal dan jenis easing berdasarkan gaya masuk.
-- Semua gaya berakhir di finalCF yang sama.
-- Balikan: titik awal, gaya easing, ARAH easing, dan lama jatuhnya.
--
-- Arah dan lama ikut dikembalikan sejak ada meteor: kedatangan lama
-- melambat di akhir (Out), meteor justru harus makin cepat (In), dan
-- keduanya hidup berdampingan lewat sakelar METEOR_ENABLED.
local function getEntrance(finalCF)
	if not METEOR_ENABLED then
		-- --- perilaku lama: jatuh 12 studs, melambat di akhir ---
		if not FX_RANDOM_IN then
			return finalCF + Vector3.new(0, DROP_HEIGHT, 0),
				Enum.EasingStyle.Back, Enum.EasingDirection.Out, DROP_TIME
		end

		local style = math.random(1, 3)
		if style == 1 then
			return finalCF + Vector3.new(0, DROP_HEIGHT, 0),
				Enum.EasingStyle.Back, Enum.EasingDirection.Out, DROP_TIME
		elseif style == 2 then
			local dir = (math.random(1, 2) == 1) and -1 or 1
			return finalCF + Vector3.new(SLIDE_DIST * dir, 0, 0),
				Enum.EasingStyle.Quint, Enum.EasingDirection.Out, DROP_TIME
		else
			return (finalCF + Vector3.new(0, DROP_HEIGHT, 0))
				* CFrame.Angles(0, math.rad(150), 0),
				Enum.EasingStyle.Quad, Enum.EasingDirection.Out, DROP_TIME
		end
	end

	-- --- METEOR ---
	--
	-- Ketiga gayanya sama-sama jatuh dari METEOR_HEIGHT dan sama-sama
	-- memakai Quart In. Yang dibedakan cuma JALURNYA, karena itu yang
	-- kelihatan; kalau easing-nya ikut diacak, sebagian kedatangan
	-- kehilangan percepatan yang bikin hentakannya terasa.
	local gaya = FX_RANDOM_IN and math.random(1, 3) or 1

	if gaya == 1 then
		-- Lurus dari atas, tegak lurus ke slotnya.
		return finalCF + Vector3.new(0, METEOR_HEIGHT, 0),
			Enum.EasingStyle.Quart, Enum.EasingDirection.In, METEOR_TIME

	elseif gaya == 2 then
		-- Menyerong dari samping-atas. Ini yang paling terbaca sebagai
		-- meteor, karena ekornya jadi garis miring panjang di layar,
		-- bukan garis tegak pendek.
		local dir = (math.random(1, 2) == 1) and -1 or 1
		return finalCF + Vector3.new(
			METEOR_SIDE * dir, METEOR_HEIGHT, -METEOR_SIDE * 0.4),
			Enum.EasingStyle.Quart, Enum.EasingDirection.In, METEOR_TIME

	else
		-- Jatuh sambil berputar.
		--
		-- Sudutnya 150 derajat, BUKAN 360 seperti dulu: CFrame.Angles(0,
		-- rad(360), 0) itu matriks identitas -- sama persis dengan tanpa
		-- putaran sama sekali. Gaya ketiga yang lama sebenarnya tidak
		-- pernah berputar, cuma jatuh lurus dengan easing berbeda.
		return (finalCF + Vector3.new(0, METEOR_HEIGHT, 0))
			* CFrame.Angles(0, math.rad(150), 0),
			Enum.EasingStyle.Quart, Enum.EasingDirection.In, METEOR_TIME
	end
end

-- Kunci avatar di posisinya TANPA memakai Anchored.
--
-- Kenapa tidak Anchored: animasi Roblox menggerakkan part lewat Motor6D,
-- dan part yang di-Anchored tidak ikut bergerak. Kalau HumanoidRootPart
-- di-anchor, avatar diam total seperti patung meskipun track:Play()
-- dipanggil dan tidak ada error apa pun.
--
-- Kekuatan penahannya HARUS ikut massa, dan ini yang dulu salah.
--
-- BodyPosition menghasilkan gaya = P * selisih - D * kecepatan, dibatasi
-- MaxForce. Untuk menahan sesuatu melawan gravitasi butuh gaya massa * g.
-- Massa avatar naik ~pangkat tiga dari skalanya: raksasa 8x kira-kira
-- 500x lebih berat dari avatar biasa.
--
-- Dengan angka tetap yang lama (MaxForce 1e6, P 10000), raksasa butuh
-- gaya ~1,5e6 -- LEBIH BESAR dari batasnya. Jadi dia mendarat di tempat
-- yang benar (masih ditarik tween, belum ada fisika), lalu begitu
-- anchor dilepas dia melorot pelan-pelan sampai separuh badan masuk
-- lantai. Persis "awalnya tidak tenggelam, beberapa detik kemudian
-- tenggelam".
--
-- Sekarang ketiga angkanya dikali massa, jadi selisih tahannya
-- (massa*g/P) tidak lagi bergantung pada ukuran avatar.
local function lockInPlace(model, hrp, targetCF)
	-- Massanya DIJUMLAH sendiri dari part-partnya, bukan dibaca dari
	-- AssemblyMass.
	--
	-- AssemblyMass baru terisi setelah fisika memproses satu langkah
	-- sesudah Anchored dilepas. Dibaca di baris yang sama seperti
	-- sebelumnya, dia masih 0 -- lalu math.max(0, 1) membuat massa
	-- dianggap 1 untuk raksasa seberat 400+. P dan D jadi kekecilan
	-- BERSAMAAN, dan pegas yang lemah tapi nyaris tanpa redaman itulah
	-- yang bikin tier 3 mantul-mantul.
	--
	-- GetMass() per part benar kapan saja, anchored atau tidak.
	local massa = 0
	pcall(function()
		for _, bagian in ipairs(model:GetDescendants()) do
			if bagian:IsA("BasePart") then
				massa += bagian:GetMass()
			end
		end
	end)
	if massa <= 0 then
		pcall(function()
			massa = hrp.AssemblyMass
		end)
	end
	massa = math.max(massa, 1)

	local bp = Instance.new("BodyPosition")
	bp.Name     = "PositionLock"
	-- Jauh di atas berat badannya sendiri, supaya tidak pernah kehabisan
	-- gaya -- yang membatasi gerakannya P dan D, bukan langit-langit ini.
	bp.MaxForce = Vector3.new(1, 1, 1) * (massa * workspace.Gravity * 200)
	bp.P        = massa * 3000
	-- Redaman kritis di P ini = 2 * akar(3000) * massa = ~110 * massa.
	-- Diambil 160 supaya sedikit LEBIH dari kritis: kelebihan redaman
	-- cuma bikin avatarnya sampai sepersekian detik lebih lambat,
	-- sedangkan kekurangan redaman bikin dia memantul-mantul.
	bp.D        = massa * 160
	bp.Position = targetCF.Position
	bp.Parent   = hrp

	local bg = Instance.new("BodyGyro")
	bg.Name      = "RotationLock"
	bg.MaxTorque = Vector3.new(1, 1, 1) * (massa * 5000)
	bg.P         = massa * 3000
	bg.D         = massa * 200
	bg.CFrame    = targetCF
	bg.Parent    = hrp

	return bp
end

local function isTrackAlive(track)
	if not track then return false end
	local ok, playing = pcall(function() return track.IsPlaying end)
	return ok and playing
end

local function findNewMaster()
	for _, t in pairs(tracks) do
		if isTrackAlive(t) then
			return t
		end
	end
	return nil
end

local function playDance(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end

	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = DANCE_ID
	anim.Parent = model

	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)

	if not ok then
		warn("Gagal load animasi:", track)
		warn("Kemungkinan animasi bukan milik akun ini, atau place " ..
			"belum di-publish.")
		return nil
	end

	track.Looped = true

	-- Play(0) = tanpa fade-in. Fade-in default 0.1 detik membuat gerakan
	-- awal terlihat meleset dari yang lain meski TimePosition sudah benar.
	track:Play(0)

	if not isTrackAlive(masterTrack) then
		masterTrack = findNewMaster()
	end

	if masterTrack and masterTrack ~= track then
		-- Inti sinkronisasi: salin posisi waktu dari master.
		track.TimePosition = masterTrack.TimePosition
	else
		masterTrack = track
	end

	return track
end

-- Penyamaan tarian DI SISI SERVER.
--
-- Ini pembukuan, BUKAN yang dilihat penonton. Bacalah sebelum menyetel
-- apa pun di sini, karena namanya menipu.
--
-- Animasi direplikasi lewat Animator: waktu server memanggil
-- `track:Play()`, yang dikirim ke tiap client cuma perintah "mainkan
-- animasi ini SEKARANG". Client lalu memutarnya sendiri dari detik nol.
-- `TimePosition` yang ditulis di server TIDAK ikut direplikasi -- tidak
-- ada satu pun paket yang membawanya.
--
-- Akibatnya: dua avatar yang mendarat berselang 4 detik memulai
-- animasinya berselang 4 detik juga di layar penonton, dan karena
-- animasinya Looped, selisih itu bertahan SELAMANYA. Gelung di bawah
-- rajin membetulkannya -- di simulasi server, yang tidak dilihat
-- siapa-siapa.
--
-- Di Studio (Play) server dan client jalan di satu proses jadi
-- kelihatan serempak. Begitu di-publish, tidak.
--
-- Yang benar-benar menyamakan tarian ada di LocalScript, bagian
-- "PENYAMAAN TARIAN". Gelung ini dibiarkan hidup karena murah dan
-- menjaga masterTrack/tracks tetap masuk akal di sisi server, bukan
-- karena dia yang menyelamatkan tampilan.
local function startResyncLoop()
	if RESYNC_EVERY <= 0 then return end

	task.spawn(function()
		while true do
			task.wait(RESYNC_EVERY)

			if not isTrackAlive(masterTrack) then
				masterTrack = findNewMaster()
			end

			if masterTrack then
				local ref = masterTrack.TimePosition
				local fixed = 0

				for slot, t in pairs(tracks) do
					if isTrackAlive(t) and t ~= masterTrack then
						if math.abs(t.TimePosition - ref) > DRIFT_LIMIT then
							t.TimePosition = ref
							fixed += 1
						end
					end
				end

				if fixed > 0 then
					print(("Resync: %d avatar disamakan"):format(fixed))
				end
			end
		end
	end)
end

-- Kosongkan panggung: hentikan semua animasi, hapus semua model dari
-- workspace, lalu mulai penomoran slot dari 1 lagi.
--
-- Penjaga `resetting` mencegah fungsi ini jalan dua kali bersamaan.
-- Geser avatar ke slot barunya tanpa memindahkannya mendadak.
--
-- BodyPosition/BodyGyro yang sudah terpasang cukup diberi target baru --
-- avatarnya meluncur sendiri ke sana. Ini juga alasan lock-nya tidak
-- dilepas: kalau di-PivotTo langsung, gerakannya patah.
-- `langsung = true` -> pindah SEKETIKA, tidak meluncur.
--
-- Kenapa perlu: kalau meluncur, avatar menempuh jalur dari tempatnya
-- sekarang ke slotnya, dan jalur itu melewati avatar lain -- mereka
-- saling dorong dan barisan jadi berantakan. Pindah seketika tidak punya
-- jalur, jadi tidak ada yang ditabrak. Dipakai saat pulih dari sorotan.
function pindahSlot(model, slot, scale, langsung)
	local dasar  = getPosition(slot)
	local tujuan = CFrame.new(
		dasar.Position.X,
		tinggiSlot(slot, nil, scale),
		dasar.Position.Z
	)

	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	-- Target lock diperbarui DULU. Kalau PivotTo jalan lebih dulu,
	-- BodyPosition sempat menyeret avatarnya balik ke titik lama.
	local lock = hrp:FindFirstChild("PositionLock")
	if lock then lock.Position = tujuan.Position end

	local rot = hrp:FindFirstChild("RotationLock")
	if rot then rot.CFrame = tujuan end

	if langsung or not lock then
		model:PivotTo(tujuan)
		-- Sisa kecepatan dari pentalan tadi masih tersimpan; kalau tidak
		-- dinolkan, avatarnya melesat lewat titik tujuan lalu terayun balik.
		hrp.AssemblyLinearVelocity  = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
end

-- Kosongkan panggung, KECUALI yang tiernya >= KEEP_TIER_FROM.
--
-- Yang sudah bayar tidak ikut terhapus. Mereka ditata ulang ke slot depan
-- (1, 2, 3, ...) dan penomoran slot dilanjutkan dari situ, jadi panggung
-- baru tetap rapi tanpa lubang di tengah.
local function resetStage()
	if resetting then return end
	resetting = true

	-- Dikumpulkan lewat indeks berurutan, BUKAN pairs(): pairs tidak
	-- menjamin urutan, dan yang selamat harus tetap berbaris sesuai
	-- urutan kedatangannya.
	local selamat = {}
	for slot = 1, slotCount do
		local model = avatars[slot]
		if model and model.Parent and (tiers[slot] or 1) >= KEEP_TIER_FROM then
			table.insert(selamat, {
				model  = model,
				track  = tracks[slot],
				tier   = tiers[slot],
				scale  = scales[slot],
				tinggi = heights[slot],
			})
		end
	end

	-- Kalau yang bayar sudah kebanyakan, relakan yang paling lama.
	while #selamat > KEEP_MAX do
		local tua = table.remove(selamat, 1)
		if tua.track then pcall(function() tua.track:Stop() end) end
		if tua.model and tua.model.Parent then
			tua.model:Destroy()
		end
	end

	-- Yang tidak selamat: hentikan animasinya, lalu hapus.
	local removed = 0
	local disimpan = {}
	for _, s in ipairs(selamat) do
		disimpan[s.model] = true
	end

	for slot = 1, slotCount do
		local model = avatars[slot]
		local track = tracks[slot]

		if not (model and disimpan[model]) then
			if track then
				pcall(function() track:Stop() end)
			end
			if model and model.Parent then
				-- Efek kecil di titik hilangnya, biar tidak lenyap begitu saja
				if FX_EXIT then
					local ok, pivot = pcall(function() return model:GetPivot() end)
					if ok then
						playBurstFX(pivot.Position, colorFromUsername(model.Name), 20)
					end
				end
				model:Destroy()
				removed += 1
			end
		end

		avatars[slot] = nil
		tracks[slot]  = nil
		tiers[slot]   = nil
		scales[slot]  = nil
		heights[slot] = nil
	end

	-- Hanya nama kerumunan yang dilupakan. Nama raksasa dipasang ulang
	-- di bawah, kalau tidak mereka jadi tidak bisa di-upgrade lagi.
	slotOf = {}
	for _, gslot in ipairs(giantOrder) do
		local gm = avatars[gslot]
		if gm and gm.Parent then
			slotOf[string.lower(gm.Name)] = gslot
		end
	end
	-- Master lama kemungkinan sudah ikut terhapus. Dikosongkan saja;
	-- findNewMaster() memilih ulang dari track yang masih hidup.
	masterTrack = nil

	-- Tata ulang yang selamat ke slot depan.
	for i, s in ipairs(selamat) do
		avatars[i] = s.model
		tracks[i]  = s.track
		tiers[i]   = s.tier
		scales[i]  = s.scale
		heights[i] = s.tinggi
		slotOf[string.lower(s.model.Name)] = i
		pindahSlot(s.model, i, s.scale)
	end

	slotCount = #selamat
	resetting = false

	print(("Panggung dikosongkan. %d dihapus, %d bertahan (tier >= %d).")
		:format(removed, #selamat, KEEP_TIER_FROM))
end

-- Lepaskan NOMOR-nya saja: podium dibongkar, semua pembukuan dibersihkan.
--
-- Fungsi ini sengaja TIDAK menghapus model avatarnya -- pemanggilnya yang
-- memutuskan nasib si model. Pakai `buangRaksasa` di bawah kalau avatarnya
-- juga harus hilang; memanggil yang ini langsung akan meninggalkan avatar
-- yatim yang berdiri selamanya di titik itu.
local function lepasSlotRaksasa(slot, langsung)
	hapusPodium(slot, langsung)

	local pemilik = ownerOf[slot]
	if pemilik and giantOwner[pemilik] == slot then
		giantOwner[pemilik] = nil
	end
	ownerOf[slot] = nil

	giantTaken[slot] = nil
	giantToken[slot] = nil
	giantModel[slot] = nil
	for i, v in ipairs(giantOrder) do
		if v == slot then
			table.remove(giantOrder, i)
			break
		end
	end
	avatars[slot] = nil
	tracks[slot]  = nil
	tiers[slot]   = nil
	scales[slot]  = nil
	heights[slot] = nil
end

-- Hapus avatar raksasa di nomor ini, lalu lepaskan nomornya.
--
-- Ini SATU-SATUNYA cara yang benar untuk mengosongkan sebuah podium.
-- Dulu isinya cuma ada di dalam pangkasRaksasa, dan jalur "pemilik yang
-- sama mengirim gift lagi" di ambilSlotRaksasa memanggil lepasSlotRaksasa
-- langsung -- nomornya lepas, tapi avatarnya tetap berdiri di sana. Yang
-- baru lalu mendarat di titik yang persis sama: dua badan menumpuk di satu
-- podium, dan yang lama tidak akan pernah hilang karena raksasa kebal
-- reset panggung.
local function buangRaksasa(slot, langsung)
	-- `giantModel` ikut dilihat: raksasa yang nomornya sudah dipesan
	-- tapi modelnya masih dibuat juga harus ikut dibuang. Kalau tidak,
	-- pembuangan "berhasil" tanpa menghapus apa pun, lalu model itu
	-- muncul beberapa detik kemudian di nomor yang sudah ditempati
	-- raksasa lain -- dua badan di satu titik.
	local model = avatars[slot] or giantModel[slot]
	local track = tracks[slot]

	if track then pcall(function() track:Stop() end) end

	if model then
		-- Efek perpisahan hanya untuk yang sudah benar-benar berdiri.
		-- Yang masih dibuat belum pernah terlihat penonton, jadi
		-- ledakan partikel di tempat kosong cuma membingungkan.
		if model.Parent then
			if FX_EXIT then
				local ok, pivot = pcall(function() return model:GetPivot() end)
				if ok then
					playBurstFX(pivot.Position,
						colorFromUsername(model.Name), 20)
				end
			end
			-- Dicek dulu: nama yang sama bisa sudah dipakai avatar
			-- lain yang lebih baru, dan itu tidak boleh ikut terhapus
			-- dari peta.
			local key = string.lower(model.Name)
			if slotOf[key] == slot then slotOf[key] = nil end
		end

		-- Destroy tetap dipanggil walau Parent masih nil: model yang
		-- baru dibuat memang belum masuk workspace, dan kalau tidak
		-- dihapus di sini dia menggantung sampai dikumpulkan sampah.
		model:Destroy()
	end

	lepasSlotRaksasa(slot, langsung)
end

-- Buang raksasa terlama sampai tersisa `sisakan`.
--
-- Raksasa tidak pernah kena reset panggung, jadi HANYA ini yang membatasi
-- jumlah mereka.
local function pangkasRaksasa(sisakan)
	while #giantOrder > sisakan do
		buangRaksasa(giantOrder[1])
		print(("Raksasa terlama dilepas (batas %d)."):format(GIANT_MAX))
	end
end

-- Nomor raksasa terkecil yang belum dipesan.
--
-- Kalau barisan belakang sudah penuh, yang terlama dibuang DI SINI --
-- sebelum nomor dipilih. Dengan begitu si pendatang menempati persis
-- tempat yang baru saja dikosongkan, bukan tempat baru di sebelahnya
-- yang bikin barisan melebar sesaat lalu berlubang di tengah.
--
-- Nomornya dipesan lewat giantTaken, bukan menunggu avatars[slot] terisi:
-- spawnAvatar jalan di task terpisah dan butuh beberapa detik, jadi dua
-- gift `rosa` yang berdekatan akan mendapat nomor yang sama kalau
-- pengecekannya cuma melihat avatar yang sudah berdiri.
local function pesanSlot(slot, pemilik)
	giantTaken[slot] = true
	-- Tabel kosong dipakai sebagai penanda unik: tiap pemesanan
	-- menghasilkan tabel baru yang tidak pernah sama dengan yang lain.
	local token = {}
	giantToken[slot] = token

	if pemilik then
		giantOwner[pemilik] = slot
		ownerOf[slot]       = pemilik
	end

	-- Ditaruh di URUTAN TERAKHIR, termasuk saat dipakai ulang: dia baru saja
	-- membayar lagi, jadi tidak boleh jadi yang pertama dipangkas.
	table.insert(giantOrder, slot)
	return slot, token
end

local function ambilSlotRaksasa(pemilik)
	-- Sudah punya podium? Pakai nomor yang SAMA, jangan ambil yang baru.
	--
	-- Podiumnya turun lalu naik lagi lengkap dengan sorotan, jadi gift
	-- keduanya tetap terasa -- yang tidak terjadi cuma penumpukan.
	-- pangkasRaksasa sengaja dilewati: memakai ulang tempat sendiri tidak
	-- menambah jumlah podium, jadi tidak ada yang perlu direlakan.
	if pemilik then
		local lama = giantOwner[pemilik]
		if lama and giantTaken[lama] then
			-- buangRaksasa, BUKAN lepasSlotRaksasa: avatar lamanya harus
			-- ikut hilang. Dia berdiri di titik yang persis sama dengan
			-- yang baru, jadi kalau cuma nomornya yang dilepas, keduanya
			-- menumpuk di satu podium selamanya.
			buangRaksasa(lama, true)
			return pesanSlot(lama, pemilik)
		end
	end

	pangkasRaksasa(GIANT_MAX - 1)

	local n = 0
	while giantTaken[GIANT_BASE + n] do
		n += 1
	end
	return pesanSlot(GIANT_BASE + n, pemilik)
end

local function playDanceAll()
	for slot, model in pairs(avatars) do
		if model.Parent and not isTrackAlive(tracks[slot]) then
			tracks[slot] = playDance(model)
		end
	end
end

local function stopDanceAll()
	for slot, track in pairs(tracks) do
		if track then
			track:Stop()
		end
		tracks[slot] = nil
	end
	masterTrack = nil
end

local function spawnAvatar(entry, slot, token)
	local username = entry.username
	local tier     = entry.tier or 1
	local scale    = entry.scale or 1
	local koin     = entry.koin or 0

	local userId = Players:GetUserIdFromNameAsync(username)
	local desc   = Players:GetHumanoidDescriptionFromUserId(userId)
	local model  = Players:CreateHumanoidModelFromDescription(
		desc,
		Enum.HumanoidRigType.R15
	)

	model.Name = username

	-- Didaftarkan SEKARANG, jauh sebelum terpasang di panggung, supaya
	-- pangkasRaksasa bisa membuangnya kalau batas raksasa terlampaui
	-- selagi model ini masih dibuat.
	if isGiantSlot(slot) then
		giantModel[slot] = model

		-- Podiumnya dibangun SEKARANG dan mulai naik, selagi avatarnya
		-- masih disiapkan. Waktu si tamu turun nanti, podiumnya sudah
		-- berdiri menunggu.
		buatPodium(slot, username, koin)
	end

	-- Pivot dipaksa ke HumanoidRootPart. Kalau PrimaryPart kosong, pivot
	-- jatuh ke titik tengah kotak pembungkus -- yang ikut bergeser kalau
	-- avatarnya pakai topi tinggi, dan semua perhitungan tinggi di bawah
	-- jadi meleset.
	local rootAwal = model:FindFirstChild("HumanoidRootPart")
	if rootAwal then
		model.PrimaryPart = rootAwal
	end

	-- ScaleTo dipakai, bukan mengubah skala di HumanoidDescription:
	-- ScaleTo ikut menyesuaikan Motor6D, jadi animasinya tetap benar.
	-- Dibungkus pcall supaya avatar tetap tampil (ukuran normal) kalau
	-- suatu saat API-nya berubah -- bukan alasan untuk gagal total.
	if TIER_ENABLED and scale ~= 1 then
		pcall(function() model:ScaleTo(scale) end)
	end

	-- Tabrakan dimatikan untuk SEMUA avatar.
	--
	-- Mereka cuma pajangan: posisinya dipegang BodyPosition, tidak ada
	-- yang perlu berdiri di atas apa pun. Tabrakan justru merusak --
	-- makin besar avatarnya makin sering anggota badannya menyerempet
	-- lantai atau tetangganya waktu menari, dan tiap serempetan itu
	-- gaya dorong yang harus dilawan BodyPosition. Itu yang bikin
	-- tarian tier 3 tersendat sementara tier 1 mulus: bukan animasinya
	-- yang beda, tapi anggota badannya yang tiga kali lebih besar
	-- menyapu wilayah tiga kali lebih luas.
	for _, bagian in ipairs(model:GetDescendants()) do
		if bagian:IsA("BasePart") then
			bagian.CanCollide = false
		end
	end

	-- Model membesar dari pivotnya, jadi yang besar harus ikut diangkat
	-- supaya kakinya tidak terbenam di lantai. Tingginya DIUKUR dari
	-- model ini, sesudah ScaleTo di atas -- bukan ditebak dari skala.
	--
	-- Semua mendarat LANGSUNG di slotnya, raksasa sekalipun. Untuk slot
	-- raksasa getPosition sudah menunjuk ke barisan belakang.
	local dasar   = getPosition(slot)
	local finalCF = CFrame.new(
		dasar.Position.X,
		tinggiSlot(slot, model, scale),
		dasar.Position.Z
	)
	local startCF, easing, arahEasing, lamaJatuh = getEntrance(finalCF)
	local color           = colorFromUsername(username)

	-- Posisikan SEBELUM masuk workspace, supaya tidak sempat
	-- terlihat sekejap di titik (0,0,0).
	model:PivotTo(startCF)

	-- Anchor SEBELUM masuk workspace. Kalau tidak, fisika langsung
	-- menjatuhkan avatar selama SETTLE_TIME berjalan, sehingga terlihat
	-- jatuh dua kali.
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.Anchored = true
	end

	-- Lamanya disamakan dengan sisa perjalanan avatarnya: SETTLE_TIME
	-- (menunggu skala badan selesai) + lama jatuh. Kamera berhenti tepat
	-- di frame yang sama dengan hentakan mendaratnya.
	focusCamera(finalCF.Position, scale,
		SETTLE_TIME + (lamaJatuh or DROP_TIME))

	model.Parent = workspace
	createNameplate(model, username,
		TIER_ENABLED and entry.nameStyle or nil, scale, koin)

	-- Beri waktu ApplyDescription menyelesaikan skala badan.
	task.wait(SETTLE_TIME)
	if not model.Parent then return end

	-- Ukur ULANG di sini. Pengukuran di atas dilakukan sebelum
	-- ApplyDescription selesai, jadi tinggi badannya bisa belum final --
	-- dan tinggi yang meleset sedikit saja langsung terlihat sebagai
	-- kaki mengambang atau terbenam pada avatar besar.
	finalCF = CFrame.new(
		dasar.Position.X,
		tinggiSlot(slot, model, scale),
		dasar.Position.Z
	)

	-- Pastikan posisi tetap benar setelah skala diterapkan.
	model:PivotTo(startCF)

	if hrp then
		-- Ekornya dipasang SESUDAH PivotTo terakhir. Dipasang lebih awal,
		-- Trail sempat menggambar garis dari posisi lamanya ke titik awal
		-- jatuh -- coretan di udara yang tidak pernah ditempuh siapa pun.
		local ekor = pasangEkorMeteor(model, color)

		local tween = TweenService:Create(
			hrp,
			TweenInfo.new(lamaJatuh or DROP_TIME, easing,
				arahEasing or Enum.EasingDirection.Out),
			{ CFrame = finalCF }
		)
		-- Dibunyikan DI SINI, bukan lebih awal.
		--
		-- Di atas masih ada task.wait(SETTLE_TIME) menunggu skala badan
		-- selesai, dan selama itu avatarnya diam di titik awal. Desing
		-- yang mulai sebelum benda apa pun bergerak terdengar seperti
		-- suara nyasar.
		playFallSound(lamaJatuh or DROP_TIME)

		tween:Play()
		tween.Completed:Wait()

		lepasEkorMeteor(ekor)

		-- Efek dimainkan setelah benar-benar mendarat
		playLandingFX(finalCF.Position, color)
		playShockwave(finalCF.Position, color, lantaiSlot(slot))
		playLandSound(tier)
		playWowSound(tier)

		if METEOR_ENABLED then
			-- Cincin kedua, sedikit terlambat dan putih.
			--
			-- Satu cincin terbaca sebagai "efek spawn"; dua cincin
			-- beruntun dengan warna berbeda terbaca sebagai HENTAKAN.
			-- Jedanya sengaja kecil -- lebih dari seperlima detik dan
			-- keduanya jadi dua kejadian terpisah, bukan satu benturan.
			task.delay(0.09, function()
				playShockwave(finalCF.Position,
					Color3.fromRGB(255, 255, 255), lantaiSlot(slot))
			end)

			-- Makin tinggi tiernya makin keras guncangannya. Ini satu-
			-- satunya bagian dari kedatangan yang ikut naik oleh tier --
			-- selebihnya (ekor, tinggi jatuh, cincin) sama untuk semua,
			-- supaya yang gratis tetap enak ditonton.
			guncangKamera(SHAKE_POWER * (1 + (tier - 1) * 0.35), SHAKE_TIME)
		end

		-- Efek tier memakai warna emas, bukan warna per-username:
		-- tier harus terbaca sebagai "yang ini bayar", dan warna acak
		-- per orang justru mengaburkan itu.
		mainkanEfek(model, entry.effects, finalCF.Position,
			Color3.fromRGB(255, 215, 90), lantaiSlot(slot), koin)

		-- Lepas anchor, ganti dengan BodyPosition.
		-- WAJIB, kalau tidak animasi tidak akan jalan.
		hrp.Anchored = false
		lockInPlace(model, hrp, finalCF)
	end

	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

		-- Serahkan sepenuhnya ke BodyPosition.
		--
		-- Humanoid punya mesin keadaan sendiri yang terus-menerus
		-- menembakkan sinar ke bawah dan MENDORONG badan supaya berdiri
		-- setinggi HipHeight. Dorongan itu tidak ikut massa dengan cara
		-- yang sama seperti BodyPosition, jadi pada avatar besar keduanya
		-- tarik-menarik -- dan hasilnya tarian yang bergetar.
		--
		-- State Physics mematikan campur tangan itu; animasi tetap jalan
		-- normal karena animasi digerakkan Motor6D, bukan mesin keadaan.
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.Physics)
		end)
		-- API yang lebih baru; diabaikan diam-diam kalau belum ada.
		pcall(function()
			hum.EvaluateStateMachine = false
		end)
	end

	-- Nomornya masih milik kita?
	--
	-- Membuat avatar butuh beberapa detik. Kalau selama itu batas raksasa
	-- terlampaui, nomor ini sudah dilepas dan mungkin sudah ditempati
	-- pendatang yang lebih baru. Memasangnya sekarang berarti dua badan
	-- berdiri di satu titik -- itu tumpukan tier 3 yang kamu lihat.
	if isGiantSlot(slot) and giantToken[slot] ~= token then
		model:Destroy()
		print(("%s dibatalkan: nomor raksasanya keburu diambil yang lain")
			:format(username))
		return
	end

	if isGiantSlot(slot) then
		giantModel[slot] = nil
	end

	avatars[slot] = model
	tiers[slot]   = tier
	scales[slot]  = scale
	slotOf[string.lower(username)] = slot

	-- Dia sudah berdiri; kalau dia yang membuka baris baru, nama-nama di
	-- baris belakangnya lepas sekarang.
	hapusNamaBarisBelakang(slot)

	if AUTO_DANCE then
		tracks[slot] = playDance(model)
	end

	-- Sorotan dijalankan paling akhir, setelah avatarnya benar-benar
	-- berdiri di tempat. Kalau dipanggil lebih awal, kamera menyorot
	-- posisi yang avatarnya belum sampai.
	if TIER_ENABLED and entry.spotlight then
		runSpotlight(model, entry.spotlightMs, isGiantSlot(slot))
	end

	-- tiktokUser dicetak supaya saat live kamu bisa mencocokkan avatar
	-- di panggung dengan siapa yang mengirim gift di kolom komentar.
	local dari = entry.tiktokUser and (" <- " .. entry.tiktokUser) or ""
	if isGiantSlot(slot) then
		print(("[podium %d/%d] %s tampil (tier %d, %d koin, userId: %d)%s")
			:format(slot - GIANT_BASE + 1, GIANT_MAX, username, tier,
				koin, userId, dari))
	else
		print(("[%d/%d] %s tampil (tier %d, userId: %d)%s")
			:format(slot, DELETE_AFTER, username, tier, userId, dari))
	end

	return model
end

-- Orang yang avatarnya SUDAH berdiri lalu mengirim gift.
--
-- Jangan di-spawn kembar: dia dinaikkan di tempat. Balikan true berarti
-- entri ini sudah ditangani dan tidak perlu slot baru.
local function upgradeAvatar(entry)
	if not TIER_ENABLED or not UPGRADE_IN_PLACE then return false end

	local key  = string.lower(entry.username)
	local slot = slotOf[key]
	if not slot then return false end

	local model = avatars[slot]
	if not model or not model.Parent then
		-- Panggung sempat direset; anggap saja belum ada.
		slotOf[key] = nil
		return false
	end

	local tierBaru = entry.tier or 1
	if tierBaru <= (tiers[slot] or 1) then
		-- Tidak ada yang bisa dinaikkan (tier sama atau lebih rendah).
		--
		-- Dulu entri ini dibuang diam-diam. Itu salah untuk siaran: orang
		-- yang mengetik ulang namanya melihat panggung tidak bereaksi sama
		-- sekali dan mengira sistemnya rusak. Sekarang dibiarkan lewat --
		-- pemanggilnya akan men-spawn avatar baru, jadi tetap ada yang
		-- muncul. Kembar di panggung jauh lebih baik daripada senyap.
		--
		-- Yang lama TIDAK dihapus: dia masih menari di slotnya sampai
		-- panggung direset seperti biasa.
		return false
	end

	local scale = entry.scale or 1

	-- Naik ke tier 3 dari dalam kerumunan: dia harus PINDAH ke podium.
	-- Podium tidak bisa muncul di tengah barisan -- alasnya selebar dua
	-- slot dan kolom cahayanya akan menutupi tetangganya.
	--
	-- Slot kerumunan yang ditinggalkan sengaja dibiarkan kosong. Menggeser
	-- semua orang di belakangnya maju satu langkah cuma untuk menutup satu
	-- lubang justru terlihat seperti panggung goyang; reset berikutnya
	-- merapikannya sendiri.
	if TIER_ENABLED and tierBaru >= GIANT_TIER_FROM and not isGiantSlot(slot) then
		local baru    = ambilSlotRaksasa(entry.tiktokUser or entry.username)
		avatars[baru] = model
		tracks[baru]  = tracks[slot]

		avatars[slot] = nil
		tracks[slot]  = nil
		tiers[slot]   = nil
		scales[slot]  = nil

		slot        = baru
		slotOf[key] = slot
	end

	tiers[slot]  = tierBaru
	scales[slot] = scale

	pcall(function() model:ScaleTo(scale) end)

	-- Diukur SESUDAH ScaleTo, kalau tidak tingginya masih tinggi lama.
	local dasar   = getPosition(slot)
	local finalCF = CFrame.new(
		dasar.Position.X,
		tinggiSlot(slot, model, scale),
		dasar.Position.Z
	)

	model:PivotTo(finalCF)

	-- Kunci posisinya ikut digeser, kalau tidak BodyPosition langsung
	-- menariknya balik ke titik lama yang sekarang terlalu rendah.
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp then
		local lock = hrp:FindFirstChild("PositionLock")
		if lock then lock.Position = finalCF.Position end
		local rot = hrp:FindFirstChild("RotationLock")
		if rot then rot.CFrame = finalCF end
	end

	createNameplate(model, entry.username, entry.nameStyle, scale, entry.koin or 0)
	mainkanEfek(model, entry.effects, finalCF.Position,
		Color3.fromRGB(255, 215, 90), lantaiSlot(slot), entry.koin or 0)

	if entry.spotlight then
		runSpotlight(model, entry.spotlightMs, isGiantSlot(slot))
	end

	print(("%s NAIK ke tier %d%s"):format(
		entry.username, tierBaru,
		entry.tiktokUser and (" <- " .. entry.tiktokUser) or ""))
	return true
end

local function fetchNext()
	local ok, res = pcall(function()
		return HttpService:RequestAsync({
			Url     = URL .. "/api/next",
			Method  = "GET",
			Headers = { ["ngrok-skip-browser-warning"] = "true" },
		})
	end)

	if not ok then
		warn("Request gagal:", res)
		return nil
	end

	if res.StatusCode ~= 200 then
		warn("HTTP", res.StatusCode, res.Body)
		return nil
	end

	local decoded, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
	if not decoded then
		warn("Body bukan JSON valid:", res.Body)
		return nil
	end

	if not data.username then
		return nil
	end

	-- Seluruh entri dikembalikan, bukan username saja. Field tier boleh
	-- tidak ada -- pemanggilnya sudah memberi nilai default.
	return data
end

