	-- Kalau yang selamat boleh sebanyak kapasitas panggung, panggung tidak
	-- pernah punya tempat kosong dan loop utama minta reset tiap kali.
	if KEEP_MAX >= DELETE_AFTER then
		warn(("KEEP_MAX (%d) harus lebih kecil dari DELETE_AFTER (%d), " ..
			"kalau tidak panggung akan reset terus-menerus.")
			:format(KEEP_MAX, DELETE_AFTER))
	end
end

-- ============ ANGKA KAMERA UNTUK CLIENT ============
--
-- Ditarik oleh LocalScript sekali saat dia mulai, bukan didorong lewat
-- PlayerAdded. Sebabnya urutan: PlayerAdded di server sering menyala
-- SEBELUM LocalScript-nya sempat jalan, dan paket yang dikirim ke client
-- yang belum mendengarkan itu hilang begitu saja -- penonton itu lalu
-- duduk dengan kamera default sampai ada kedatangan berikutnya.
-- Ditarik dari sana, tidak ada balapan yang bisa kalah.
--
-- `crowd` ikut dikirim supaya penonton yang masuk di TENGAH siaran
-- langsung menghadap panggung, bukan menunggu orang berikutnya datang.
KameraConfig.OnServerInvoke = function()
	return {
		up     = CAMERA_UP,
		back   = CAMERA_BACK,
		floorY = FLOOR_Y,

		shakeEnabled = SHAKE_ENABLED,

		-- Sorotan podium (tier 3) dan sorotan lantai (tier 2).
		spotFar      = SPOT_CAM_FAR,
		spotNear     = SPOT_CAM_NEAR,
		spotUpFar    = SPOT_CAM_UP_FAR,
		spotUpNear   = SPOT_CAM_UP_NEAR,
		spotSweep    = SPOT_CAM_SWEEP,

		spot2Far     = SPOT2_CAM_FAR,
		spot2Near    = SPOT2_CAM_NEAR,
		spot2UpFar   = SPOT2_CAM_UP_FAR,
		spot2UpNear  = SPOT2_CAM_UP_NEAR,
		spot2Sweep   = SPOT2_CAM_SWEEP,

		bias   = SPOT_CAM_BIAS,
		crowd  = titikKerumunan(),

		-- Penyamaan tarian dikerjakan client (TimePosition tidak
		-- direplikasi dari server), tapi angkanya tetap disetel di sini.
		resyncEvery = RESYNC_EVERY,
		driftLimit  = DRIFT_LIMIT,
	}
end

startResyncLoop()

while true do
	local entry = fetchNext()

	if entry then
		-- Sudah berdiri di panggung? Naikkan tiernya, jangan bikin
		-- kembaran. upgradeAvatar balikan true kalau sudah ditangani.
		if not upgradeAvatar(entry) then
			-- Raksasa punya barisan sendiri di belakang. Dia TIDAK
			-- mengambil slot kerumunan, TIDAK dihitung terhadap
			-- DELETE_AFTER, dan karena itu tidak pernah ikut memicu reset.
			local raksasa = TIER_ENABLED
				and (entry.tier or 1) >= GIANT_TIER_FROM

			local slot, token
			if raksasa then
				-- Kunci pemilik: nama TikTok-nya. Push manual (lewat /docs)
				-- tidak punya itu, jadi username Roblox yang dipakai --
				-- kalau tidak, semua push manual dianggap satu orang yang
				-- sama dan saling menimpa podium.
				slot, token = ambilSlotRaksasa(
					entry.tiktokUser or entry.username)
			else
				-- Panggung sudah penuh? Kosongkan DULU, baru avatar ini
				-- ditempatkan sebagai slot 1 di panggung yang baru.
				if DELETE_AFTER > 0 and slotCount >= DELETE_AFTER then
					task.wait(RESET_DELAY)
					resetStage()
				end

				slotCount += 1
				slot = slotCount
			end

			task.spawn(function()
				local ok, err = pcall(spawnAvatar, entry, slot, token)
				if not ok then
					warn(("Gagal load '%s': %s")
						:format(entry.username, tostring(err)))
					-- Nomornya dikembalikan, kalau tidak barisan belakang
					-- berlubang permanen di tempat yang gagal itu. Dicek
					-- dulu: kalau nomornya sudah dipegang pendatang lain,
					-- yang dilepas justru punya orang.
					--
					-- buangRaksasa, supaya model setengah jadi ikut dihapus.
					-- spawnAvatar bisa gagal SESUDAH modelnya masuk
					-- workspace, dan model itu tidak akan pernah dibersihkan
					-- oleh siapa pun -- raksasa kebal reset panggung.
					if raksasa and giantToken[slot] == token then
						buangRaksasa(slot)
					end
				end
			end)
		end
	end

	task.wait(POLL_INTERVAL)
end