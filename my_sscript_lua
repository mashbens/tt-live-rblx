--[[
    Roblox Avatar Queue Viewer  (v13)
    Taruh di: ServerScriptService (Insert Object > Script)

    BUTUH DUA SCRIPT. Yang ini pasangannya kamera_client_lua, yang harus
    ditaruh di StarterPlayer > StarterPlayerScripts sebagai LocalScript
    bernama KameraClient. Tanpa itu panggungnya tetap jalan tapi
    KAMERANYA TIDAK BERGERAK -- penonton memandang avatarnya sendiri.

    Sebabnya: workspace.CurrentCamera itu milik client dan tidak pernah
    direplikasi ke server. Di Studio (Play) server dan client jalan di
    satu proses jadi kode kamera dari server kebetulan kena; di game yang
    sudah di-publish tidak. RemoteEvent-nya dibuat sendiri oleh script
    ini, jadi tidak ada objek ketiga yang perlu di-insert manual.

    Perubahan dari v12 -- TIER:
    - /api/next sekarang mengirim tier beserta ukuran, efek, gaya nama,
      dan penanda sorotan. Script ini tinggal membaca; tidak ada tabel
      tier yang disimpan di sini. Mau menyetel? Ubah di server (.env),
      tidak perlu menyentuh Studio lagi.

        tier 1 = komentar biasa      ukuran normal, tanpa efek
        tier 2 = >= 1 koin           lebih besar, aura berkilau, nama emas,
                                     dan SOROTAN kamera 5 detik di lantai
        tier 3 = >= 10 koin ATAU     PODIUM sendiri + kolom cahaya emas,
                 2.000 tap layar     confetti + kembang api, mahkota, dan
                                     sorotan 7 detik ke atas dari podium

      Panjang sorotan datang dari server (spotlightMs); yang di sini cuma
      angka kameranya. Podium dan lantai pakai dua set angka berbeda --
      lihat SPOT_CAM_* dan SPOT2_CAM_*.

    - Orang yang sudah berdiri di panggung lalu mengirim gift di-spawn
      LAGI sebagai avatar baru bertier lebih tinggi; yang lama dibiarkan.
      Set UPGRADE_IN_PLACE = true kalau mau dinaikkan di tempat.
    - Kalau server belum mengirim field tier (versi lama), semuanya
      dianggap tier 1 dan script ini berperilaku persis seperti v12.
      Set TIER_ENABLED = false untuk mematikannya sepenuhnya.

    Cara pakai:
    1. Nyalakan Allow HTTP Requests (File > Game Settings > Security)
    2. Jalankan FastAPI + tunnel (make server / make tunnel)
    3. Ganti URL dan DANCE_ID di bawah
    4. Pastikan KameraClient sudah ada di StarterPlayerScripts
    5. Tekan Play
    6. Push username lewat http://localhost:8000/docs
--]]

local Players      = game:GetService("Players")
local HttpService  = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local Debris       = game:GetService("Debris")
local RunService   = game:GetService("RunService")

-- ============ PENGATURAN ============

local URL           = "https://rblx.buanaglobalcipta.com"

-- Jeda antar tanya ke server, detik.
--
-- Ini ongkos tetap yang dibayar SEMUA avatar, termasuk yang barusan kirim
-- gift: seberapa cepat pun servernya menaruh dia di depan antrian, Studio
-- baru tahu pada polling berikutnya. Diturunkan dari 2 ke 1 -- satu request
-- kecil per detik tidak terasa di sisi server, tapi memotong separuh jeda
-- yang paling kelihatan saat live.
local POLL_INTERVAL = 1

local DANCE_ID      = "rbxassetid://106865236633450"
local AUTO_DANCE    = true

-- Batas jumlah avatar di panggung. Setelah penuh, avatar berikutnya
-- akan mengosongkan panggung lebih dulu lalu menempati slot 1.
-- Set 0 untuk mematikan auto reset (avatar menumpuk terus).
local DELETE_AFTER  = 100

-- Jeda sebelum panggung dikosongkan, supaya penonton sempat melihat
-- barisan yang penuh sebelum hilang.
local RESET_DELAY   = 3

-- Sembunyikan avatar PENONTON (bukan avatar antrian).
--
-- Penonton yang join dapat karakter sendiri dan berdiri di tengah
-- panggung, ikut masuk frame di tiap bidikan kamera. true = tidak ada
-- karakter yang di-load sama sekali, penonton jadi kamera terbang murni.
--
-- false = perilaku lama, karakter penonton tetap ada.
local HIDE_PLAYER_AVATAR = false

-- Efek (matikan salah satu kalau terasa berlebihan)
local FX_PARTICLES  = true    -- ledakan partikel + kilat cahaya saat mendarat
local FX_SHOCKWAVE  = true    -- cincin gelombang melebar di lantai
local FX_RANDOM_IN  = true    -- gaya masuk diacak. false = selalu jatuh lurus
local FX_COLOR_NAME = true    -- nameplate berwarna per avatar
local FX_EXIT       = true    -- efek partikel saat avatar dihapus

-- Suara mendarat
--
-- Mau ganti? View > Toolbox > Audio di Studio, cari "impact" / "boom" /
-- "thunder", klik kanan hasilnya > Copy Asset ID, tempel di bawah.
-- Dikosongkan ("") = tanpa suara, bukan error.
-- "Rocks Dirt Impacts In Ground 40 (SFX)" -- Pro Sound Effects.
-- Hentakan tanah 0,5 detik. Pendek, jadi yang bikin terdengar besar itu
-- penurunan nadanya di tier 3, bukan panjang suaranya.
local FX_SOUND      = true
local LAND_SOUND_ID = "rbxassetid://9118687440"

-- Tier berapa ke atas yang berbunyi. 3 = hanya rosa.
--
-- Kenapa bukan semua: tier 1 masuk terus-menerus saat live ramai, dan
-- hentakan tiap beberapa detik jadi berisik, bukan dramatis. Dibatasi ke
-- tier 3 saja, bunyinya jadi penanda: "ada yang bayar besar".
-- Set 1 kalau mau semua avatar berbunyi, atau 2 untuk rose ke atas.
local LAND_SOUND_MIN_TIER = 3

-- Tier 3 sengaja lebih keras DAN lebih rendah nadanya. Nada rendah itu
-- yang bikin terdengar "menggelegar", bukan sekadar keras -- suara yang
-- cuma dikeraskan terdengar pecah, bukan besar.
--
-- Dua angka non-tier3 di bawah baru terpakai kalau LAND_SOUND_MIN_TIER
-- diturunkan.
local LAND_VOLUME       = 0.6     -- tier 1 & 2
local LAND_VOLUME_TIER3 = 3.0
local LAND_PITCH        = 1.0
local LAND_PITCH_TIER3  = 0.55

-- Suara meteor jatuh -- SEMUA tier, dibunyikan saat MULAI jatuh.
--
-- Perannya berbeda dari LAND_SOUND_ID dan karena itu aturannya juga
-- berbeda. Hentakan mendarat dibatasi tier 3 supaya bunyinya berarti
-- "ada yang bayar besar"; desing jatuh ini justru harus ada di SETIAP
-- kedatangan -- dia yang bikin penonton menoleh ke layar sebelum
-- avatarnya kelihatan, dan itu gunanya sama untuk yang gratis maupun
-- yang bayar.
--
-- Karena berbunyi terus-menerus saat live ramai, volumenya sengaja
-- ditahan jauh di bawah hentakan tier 3. Suara yang muncul tiap beberapa
-- detik dan sama kerasnya dengan momen puncak justru menghapus momen
-- puncaknya.
local FALL_SOUND_ID = "rbxassetid://133656054745346"
local FALL_VOLUME   = 0.7

-- Dipotong tepat saat mendarat, tidak dibiarkan habis sendiri.
--
-- Panjang rekamannya belum tentu sama dengan lama jatuhnya, dan desing
-- yang masih berbunyi SESUDAH avatarnya mendarat terdengar seperti suara
-- yang ketinggalan -- dia menutupi hentakan mendaratnya, yaitu bunyi
-- yang justru harus terdengar.
--
-- Dipudarkan, bukan dimatikan mendadak: potongan keras di tengah
-- gelombang bunyi terdengar sebagai "klik".
local FALL_FADE     = 0.15

-- Mulai memutar dari detik ke berapa, bukan dari awal rekaman.
--
-- Ini yang paling mungkin perlu kamu setel. Jatuhnya cuma METEOR_TIME
-- (0,7 detik), sementara rekaman meteor biasanya 2-5 detik dan bagian
-- yang paling keras ada di UJUNGNYA -- tepat sebelum benturan. Diputar
-- dari 0, yang kedengaran cuma bagian pelan pembukanya lalu dipotong,
-- dan desingnya tidak pernah sampai ke puncaknya.
--
-- Cara menyetel: buka asset-nya di Studio (Toolbox > Audio, klik Play),
-- lihat di detik ke berapa suaranya mulai naik, lalu isi angka itu
-- DIKURANGI lama jatuhnya. Contoh: kalau puncaknya di detik 2,5 dan
-- METEOR_TIME 0,7 -- isi 1,8.
--
-- 0 = putar dari awal.
local FALL_SOUND_START = 0

-- Dua suara khusus tier 3. Dikosongkan ("") = dilewati, bukan error.
--
-- Urutannya disusun jadi satu kalimat, bukan ditumpuk jadi satu suara:
--     0,00 s  hentakan mendarat  (LAND_SOUND_ID, nada diturunkan)
--     0,35 s  sorakan "wow"      -- reaksi, jadi harus SESUDAH hentakan
--     lalu    kembang api        -- ikut tiap letusan, tiga kali
--
-- Kalau ketiganya dibunyikan bersamaan, yang terdengar cuma satu
-- gumpalan ribut dan tidak satu pun terbaca sebagai apa.
local WOW_SOUND_ID      = "rbxassetid://136357088509992"
local WOW_VOLUME        = 0.2
local WOW_DELAY         = 0.35   -- jeda sesudah hentakan mendarat

local FIREWORK_SOUND_ID = "rbxassetid://108875729772405"
local FIREWORK_VOLUME   = 1.1

-- Sinkronisasi gerakan
--
-- Tiap berapa detik semua tarian disamakan ke satu "master", dan seberapa
-- meleset baru dianggap perlu disamakan.
--
-- Diperketat dari 10 detik / 0,08: dengan angka lama, avatar yang baru
-- mendarat bisa meleset sampai SEPULUH DETIK sebelum ada yang
-- membetulkan -- dan sepuluh detik itu selamanya di layar. Sekarang 3
-- detik, dengan toleransi setengahnya.
--
-- Jangan diturunkan sampai di bawah 1: menyetel TimePosition itu sendiri
-- membuat gerakannya meloncat sedikit, jadi menyamakan terlalu sering
-- justru terlihat seperti tersendat.
--
-- PENTING: yang benar-benar menyamakan tarian di layar penonton itu
-- LocalScript, bukan gelung di file ini. AnimationTrack.TimePosition
-- yang disetel di server TIDAK direplikasi ke client -- lihat catatan
-- panjang di startResyncLoop. Dua angka ini dikirim ke sana lewat
-- KameraConfig, jadi menyetelnya tetap cukup di sini.
local RESYNC_EVERY  = 3
local DRIFT_LIMIT   = 0.04

-- Susunan barisan
local ROW_SIZE      = 6
local SPACING_X     = 8      -- jarak kiri-kanan. Dinaikkan dari 6 karena
-- tier 2 (2x) dan tier 3 (2.2x) saling menembus
local SPACING_Z     = 8
local BASE_Y        = 5

-- Animasi masuk
local DROP_HEIGHT   = 12
local DROP_TIME     = 0.6
local SLIDE_DIST    = 35      -- jarak awal untuk gaya masuk "meluncur"
local SETTLE_TIME   = 0.5     -- JANGAN dihapus, ini yang mencegah avatar melar

-- --- Kedatangan METEOR ---
--
-- Kedatangan gratis (tier 1) itu yang paling sering dilihat penonton --
-- gift datang sesekali, komentar datang terus. Jadi yang harus menarik
-- justru yang tidak dibayar.
--
-- Tapi menariknya sengaja lewat GERAKAN, bukan lewat emas dan cahaya:
-- jatuh dari jauh lebih tinggi, makin cepat menjelang lantai, ekor
-- cahaya, lalu hentakan yang mengguncang kamera. Kalau tier 1 dikasih
-- kolom emas atau kembang api, tidak ada lagi yang tersisa untuk dibeli.
--
-- Set METEOR_ENABLED = false untuk kembali ke jatuh 12 studs seperti dulu.
local METEOR_ENABLED = true

-- Tinggi jatuhnya. 55 studs itu di LUAR layar dari sudut kamera sekarang,
-- dan memang begitu maunya: avatarnya masuk frame dari tepi atas dengan
-- kecepatan penuh, bukan muncul dari udara kosong di tengah layar.
local METEOR_HEIGHT  = 55

-- Lama jatuh. Lebih panjang sedikit dari DROP_TIME karena jaraknya
-- hampir lima kali lipat; easing-nya "In" (makin cepat), bukan "Out" --
-- itu satu-satunya alasan pendaratannya terasa berat. Jatuh yang
-- melambat di akhir terbaca sebagai diturunkan pakai tali.
local METEOR_TIME    = 0.7

-- Jarak menyamping untuk meteor yang menyerong.
local METEOR_SIDE    = 26

-- Ekor cahaya di belakangnya selama jatuh.
local METEOR_TRAIL       = true
local METEOR_TRAIL_LIFE  = 0.35   -- lama ekor bertahan (detik)
local METEOR_TRAIL_WIDTH = 4      -- lebar ekor (studs)

-- Guncangan kamera saat mendarat.
--
-- Ini bagian yang paling terasa dan paling murah: gerakan kamera yang
-- BEREAKSI membuat penonton merasa ada bobotnya, tanpa satu pun partikel
-- tambahan. Pendek saja -- guncangan panjang bikin mual, bukan megah.
local SHAKE_ENABLED  = true
local SHAKE_TIME     = 0.18
local SHAKE_POWER    = 1.1    -- studs, di awal guncangan

-- Kamera
--
-- BACK itu jarak mundur dari avatar (negatif = di belakang kamera arah
-- pandang), UP tingginya. Dua-duanya dikali skala avatar di focusCamera,
-- jadi menaikkan angka di sini memundurkan kamera untuk SEMUA tier
-- sekaligus, bukan cuma yang kecil.
local CAMERA_BACK   = -16

-- Diturunkan 7 -> 3 supaya PODIUM ikut masuk frame.
--
-- Angka 7 bukan "agak ketinggian", tapi persis melewati batas. Kamera
-- membidik avatar kerumunan dan berdiri 7 studs di atasnya dari jarak
-- 16, jadi sumbu pandangnya menunduk 23,6 derajat. Podium berdiri jauh
-- di belakang (Z = 48) dan puncak kepala tamunya ada di sekitar 26
-- studs, yaitu 12,4 derajat DI ATAS sumbu itu -- total 36 derajat dari
-- tengah layar, sementara setengah FieldOfView Roblox cuma 35. Lewat
-- satu derajat, dan podiumnya terpotong tepat di tepi atas.
--
-- Di angka 3 sumbunya cuma menunduk 10,6 derajat dan kepala podium jatuh
-- di 26,3 derajat -- masuk dengan sisa ruang, bukan mepet lagi.
--
-- Kalau podiumnya masih kurang kelihatan, turunkan lagi (2 masih wajar)
-- SEBELUM menyentuh CAMERA_BACK: memundurkan kamera memang memuat lebih
-- banyak, tapi sekaligus mengecilkan orang yang barusan datang -- dan
-- dia yang seharusnya jadi pusat perhatian saat mendarat.
local CAMERA_UP     = 3
local CAMERA_TIME   = 0.8

-- Gerakan kamera diacak tiap kedatangan.
--
-- Semua gaya BERAKHIR di titik yang sama (targetPos + CAMERA_UP/BACK) dan
-- selama bergerak selalu MEMANDANG orangnya. Dua aturan itu yang bikin
-- variasinya terbaca sebagai sinematik, bukan sebagai kamera bingung:
-- yang berubah cuma dari mana dia datang, bukan di mana dia berhenti --
-- jadi panggung selalu kembali ke bingkai yang sama dan penonton tidak
-- pernah kehilangan arah.
--
-- Gerakannya juga disetel supaya SELESAI tepat saat avatarnya mendarat,
-- bukan sebelum atau sesudah. Kamera yang masih melayang waktu hentakan
-- terjadi bikin dua kejadian saling menutupi.
--
-- false = kembali ke satu gerakan tetap seperti dulu (geser halus).
local CAM_CINEMATIC = true

-- Nameplate
local PLATE_OFFSET  = 2.2
local PLATE_WIDTH   = 130
local PLATE_HEIGHT  = 24
local PLATE_DIST    = 200

-- Papan nama tanpa kotak dan tanpa garis tepi -- teks mengambang saja.
--
-- Yang tersisa cuma bayangan tipis PADA HURUFNYA (bukan kotak di
-- belakangnya). Tanpa itu, nama putih di atas langit terang atau baju
-- putih avatar lain jadi tidak terbaca sama sekali. Set false kalau mau
-- benar-benar polos.
local PLATE_TEXT_SHADOW = true

-- Papan nama HANYA di baris paling depan.
--
-- Avatarnya TIDAK disentuh: yang di belakang tetap berdiri dan tetap
-- menari, cuma namanya yang dilepas begitu ada orang mengisi baris di
-- depannya. Kerumunan tumbuh ke arah kamera, jadi baris yang lebih baru
-- selalu berdiri lebih dekat -- dan papan nama baris belakang menembus
-- badan mereka, saling menumpuk, sampai layar penuh tulisan yang tidak
-- satu pun kebaca.
--
-- Podium tidak ikut aturan ini. Nomornya di luar barisan kerumunan, dan
-- namanya justru satu-satunya yang harus bertahan lama.
local PLATE_FRONT_ROW_ONLY = true

-- Lama papan nama menyusut sebelum dibuang. 0 = hilang seketika.
--
-- Dikasih waktu sedikit karena nama yang lenyap satu frame terbaca
-- seperti kedip/bug, sementara yang menyusut terbaca sebagai "gilirannya
-- sudah lewat" -- gerakan yang sama persis dengan waktu dia muncul,
-- dibalik.
local PLATE_FADE_OUT       = 0.25

-- Tier
-- Ini cuma sakelar lokal. Angka ukuran dan daftar efeknya datang dari
-- server, bukan dari sini.
local TIER_ENABLED   = true

-- Orang yang avatarnya SUDAH berdiri lalu mengirim gift.
--
-- false (dipakai sekarang) = avatar BARU di-spawn dengan tier barunya,
-- yang lama dibiarkan berdiri sampai reset biasa. Gift jadi selalu
-- menghasilkan sesuatu yang terlihat: pendaratan, efek, sorotan.
--
-- true = avatarnya dinaikkan di tempat, tidak ada yang baru muncul. Lebih
-- rapi, tapi saat live gift-nya nyaris tidak terasa -- yang berubah cuma
-- ukuran avatar yang sudah lama berdiri di barisan.
local UPGRADE_IN_PLACE = false

-- Permukaan lantai panggung. Telapak kaki SEMUA avatar didudukkan tepat
-- di angka ini, berapa pun skalanya. Ubah kalau lantaimu bukan di Y = 0.
local FLOOR_Y        = 0

-- Cadangan saja: dipakai HANYA kalau pengukuran model gagal.
--
-- Riwayat angka ini panjang dan semuanya salah, karena semuanya tebakan.
-- 3.0 bikin raksasa 8x terbenam 14 studs; diganti BASE_Y (5.0) malah
-- bikin raksasa 3x mengambang. Sebabnya jarak pivot-ke-telapak-kaki
-- BUKAN angka tetap -- tiap paket avatar beda tinggi kakinya.
--
-- Jadi sekarang jaraknya DIUKUR dari model yang bersangkutan
-- (lihat tinggiPivot), dan angka di bawah cuma jaring pengaman.
local SCALE_Y_LIFT   = 3.0

-- Sorotan tier 3.
--
-- Si bintang selalu dapat lampunya sendiri. Yang OPSIONAL adalah
-- meredupkan seluruh layar -- dan itu DIMATIKAN, karena hasilnya terlalu
-- gelap: panggung jadi nyaris hitam, bukan bersuasana.
--
-- Nyalakan lagi kalau mau mencoba, tapi mulai dari angka kecil:
-- SPOTLIGHT_DIM -0.15 sudah terasa, -0.4 sudah kegelapan.
local SPOTLIGHT_DIM_SCREEN = false
local SPOTLIGHT_DIM  = -0.15
local SPOTLIGHT_TINT = Color3.fromRGB(215, 210, 235)
local SPOTLIGHT_FADE = 0.6

-- Terang lampu si bintang.
--
-- Lampu ini menempel PADA badannya, jadi jaraknya nol -- angka yang
-- kelihatan wajar untuk lampu panggung biasa di sini langsung membakar
-- warna bajunya jadi putih rata. Riwayatnya: 10 (baju hilang total),
-- 2.2 (baju masih pudar), sekarang 1.0.
--
-- Tujuannya membuat dia lebih terang dari sekitarnya, bukan menyilaukan.
-- Kalau mau lebih terasa, naikkan RANGE dulu -- itu memperluas cahayanya
-- tanpa menambah terang di titik badannya sendiri.
local SPOTLIGHT_LIGHT       = 1.0
local SPOTLIGHT_LIGHT_RANGE = 30

-- Tier segini ke atas KEBAL reset panggung.
--
-- 99 = tidak ada yang kebal: SEMUA isi barisan kerumunan ikut terhapus,
-- tier 2 sekalipun. Panggung jadi benar-benar bersih tiap reset dan tier 1
-- tidak pernah kehilangan slot ke penyintas lama.
--
-- Yang bayar besar tetap aman: tier 3 tidak berada di barisan kerumunan
-- sama sekali, jadi reset tidak menyentuh mereka apa pun angka ini.
-- Set 2 kalau mau tier 2 kebal lagi.
local KEEP_TIER_FROM = 99

-- Batas jumlah penyintas. Baru terpakai kalau KEEP_TIER_FROM diturunkan;
-- tanpa batas ini panggung bisa penuh oleh penyintas saja dan minta reset
-- terus-menerus tanpa pernah ada tempat kosong.
local KEEP_MAX       = 10

-- --- Panggung tier 3: PODIUM ---
--
-- Tier 3 TIDAK dibesarkan. Ukurannya sama dengan tier 2; yang naik
-- adalah TEMPATNYA.
--
-- Kenapa begitu: membesarkan avatar mengubah massa (pangkat tiga dari
-- skalanya), tinggi pivot, jangkauan anggota badan, dan framing kamera
-- SEKALIGUS. Tiap kali salah satunya diperbaiki, yang lain bergeser --
-- kaki tenggelam, kaki mengambang, badan memantul, tarian tersendat.
-- Semuanya akibat satu keputusan yang sama.
--
-- Dengan podium, ukuran avatar tidak pernah berubah, jadi tidak satu pun
-- masalah itu bisa muncul. Dan untuk siaran hasilnya justru lebih kuat:
-- "naik podium" itu bahasa status yang langsung dimengerti penonton,
-- sementara "jadi besar" cuma terbaca sebagai efek game.
--
-- Tangganya jadi bertambah KATEGORI, bukan bertambah angka:
--     tier 1  ->  warna nama
--     tier 2  ->  cahaya (aura + nama emas)
--     tier 3  ->  tempat (podium + kolom cahaya)

-- Arah panggung, sekali dan untuk seterusnya: kamera berdiri di sisi Z
-- negatif dan menghadap ke Z positif. Jadi Z makin NEGATIF = makin dekat
-- kamera (depan), Z makin positif = makin jauh (belakang). Barisan
-- kerumunan tumbuh ke depan: baris pertama di Z = 0, baris berikutnya
-- -8, -16, dan seterusnya.

local PODIUM_ENABLED = true

-- Tinggi permukaan podium dari lantai. Inilah pembeda tier 3 yang
-- sebenarnya: kepalanya berada jauh di atas seluruh kerumunan tanpa
-- badannya membesar sedikit pun.
local PODIUM_HEIGHT  = 9

local PODIUM_RADIUS  = 6      -- jari-jari alas
local PODIUM_RISE    = 1.6    -- lama naik dari dalam tanah (detik)
local PODIUM_SINK    = 1.0    -- lama tenggelam waktu dilepas

local PODIUM_COLOR   = Color3.fromRGB(196, 148, 44)   -- emas tua, badan
local PODIUM_GLOW    = Color3.fromRGB(255, 214, 102)  -- emas terang, tepi

-- Kolom cahaya dari podium ke langit. Ini yang paling terbaca di layar
-- HP penonton: mereka tidak perlu mengenali avatarnya, cukup melihat
-- ada pilar emas menyala.
local PODIUM_BEAM_HEIGHT = 140
local PODIUM_BEAM_ALPHA  = 0.93   -- 1 = tak terlihat

-- Kolom cahaya tier 2.
--
-- Bentuknya sama dengan milik podium, tapi sengaja LEBIH KECIL di
-- ketiga ukurannya: lebih pendek, lebih tipis, lebih samar. Kalau
-- disamakan, tier 2 dan tier 3 jadi tidak terbedakan dari jauh --
